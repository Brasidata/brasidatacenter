:hasAchievement rdf:type owl:ObjectProperty ;
                rdfs:label "has Achievement"@en  .


###  http://datacenter.app.br/domain/social/ns/job.ttl#hasSkillGroup
:hasSkillGroup rdf:type owl:ObjectProperty ;
               rdfs:label "has Skill Group"@en  .


