###  http://datacenter.app.br/domain/social/ns/job.ttl#DesirableRequirement
:DesirableRequirement rdf:type owl:Class ;
                      rdfs:subClassOf :JobRequirement .


###  http://datacenter.app.br/domain/social/ns/job.ttl#EmploymentTypeEnumValue
:EmploymentTypeEnumValue rdf:type owl:Class ;
                         rdfs:subClassOf schema:DefinedTermSet ;
                         schema:description "Controlled vocabulary for employment/vínculo types used in job postings."@en  ;
                         schema:name "Employment type"@en  .

###  http://datacenter.app.br/domain/social/ns/job.ttl#JobLocationTypeEnumValue
:JobLocationTypeEnumValue rdf:type owl:Class ;
                          rdfs:subClassOf schema:DefinedTermSet ;
                          schema:description "Controlled vocabulary for where the work is performed (on-site, hybrid, remote, unknown)."@en  ;
                          schema:name 
                                      "Work location type"@en .

###  http://datacenter.app.br/domain/social/ns/job.ttl#JobRequirement
:JobRequirement rdf:type owl:Class .


###  http://datacenter.app.br/domain/social/ns/job.ttl#MandatoryRequirement
:MandatoryRequirement rdf:type owl:Class ;
                      rdfs:subClassOf :JobRequirement .


###  http://datacenter.app.br/domain/social/ns/job.ttl#SkillGroup
:SkillGroup rdf:type owl:Class ;
            rdfs:subClassOf cv:CV ;
            rdfs:comment 
                         "Skill Group"@en ;
            rdfs:label 
                       "Skill Group"@en .


