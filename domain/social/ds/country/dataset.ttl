###  http://brasidatacenter.com/domain/social/ds/country/dataset.ttl#listCountryCapability
:listCountryCapability rdf:type owl:NamedIndividual ,
                             obdc:QueryCapability ;
                    dcterms:identifier "org.ontobdc.domain.social.country.capability.query.list" ;
                    dcterms:title "List Countries"@en ;
                    dcterms:description "Reads the country dataset payload and returns a list of countries with their codes and names."@en ;
                    dcterms:version "0.1.0" ;
                    prov:wasAttributedTo :OntoBDC ;
                    prov:generatedAtTime "2026-06-12T00:00:00"^^xsd:dateTime ;
                    obdc:outputContains :countryListSchema .


:countryListSchema rdf:type owl:NamedIndividual ,
                             obdc:outputSchema ;
                             rdfs:subClassOf obdc:QueryResponse ;
                             dcterms:identifier "org.ontobdc.domain.social.country.list" ;
                             dcterms:title "List of Countries"@en ;
                             dcterms:description "List of countries with their codes and names."@en .


###  http://brasidatacenter.com/domain/social/ds/country/dataset.ttl#countryDescription
