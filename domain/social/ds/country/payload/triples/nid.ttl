###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#identifierField
ls:identifierField rdf:type owl:AnnotationProperty .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#uri
ls:uri rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://schema.org/Country
schema:Country rdf:type owl:Class .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#Directed1toNLink
ls:Directed1toNLink rdf:type owl:Class .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#LinkElement
ls:LinkElement rdf:type owl:Class .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#StringBasedIdentifier
ls:StringBasedIdentifier rdf:type owl:Class .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#URIBasedIdentifier
ls:URIBasedIdentifier rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://brasidatacenter.com/domain/social/ds/country/payload/triples/nid.ttl#AD
:AD rdf:type owl:NamedIndividual ,
             schema:Country ,
             ls:Directed1toNLink ,
             prov:Entity ;
    ls:hasFromLinkElement [ rdf:type ls:LinkElement ;
                            ls:hasIdentifier [ rdf:type ls:URIBasedIdentifier ;
                                               ls:uri :AD
                                             ]
                          ] ;
    ls:hasToLinkElement [ rdf:type ls:LinkElement ;
                          ls:hasDocument dataset:countryListFile ;
                          ls:hasIdentifier [ rdf:type ls:StringBasedIdentifier ;
                                             ls:identifier "AD" ;
                                             ls:identifierField "Code"
                                           ]
                        ] .


