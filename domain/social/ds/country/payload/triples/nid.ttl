#################################################################
#    Annotation properties
#################################################################

###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#hasDocument
ls:hasDocument rdf:type owl:AnnotationProperty .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#hasFromLinkElement
ls:hasFromLinkElement rdf:type owl:AnnotationProperty .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#hasIdentifier
ls:hasIdentifier rdf:type owl:AnnotationProperty .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#hasToLinkElement
ls:hasToLinkElement rdf:type owl:AnnotationProperty .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Linkset#identifier
