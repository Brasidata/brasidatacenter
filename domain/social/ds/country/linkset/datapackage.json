{
  "name": "ontobdc-social-country-data-package",
  "title": "OntoBDC Country Dataset Data Package",
  "description": "Frictionless Data Package descriptor for the triples payload of the OntoBDC country dataset.",
  "licenses": [
    {
      "name": "Apache-2.0"
    }
  ],
  "keywords": [
    "ontobdc",
    "social",
    "dataset",
    "data-package",
    "package"
  ],
  "version": "0.1.0",
  "resources": [
    {
      "name": "country-base-file",
      "type": "table",
      "path": "../payload/documents/country-identifier-iso3166-1-alpha-2-en.csv",
      "scheme": "file",
      "format": "text/csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "Code",
            "type": "string",
            "rdfType": "http://schema.org/identifier"
          },
          {
            "name": "Name",
            "type": "string",
            "rdfType": "http://schema.org/name"
          }
        ]
      }
    },
    {
      "name": "org.ontobdc.domain.social.country.list",
      "type": "file",
      "profile": "data-resource",
      "path": "../payload/triples/nid.ttl",
      "scheme": "file",
      "format": "ttl",
      "mediatype": "text/turtle",
      "encoding": "utf-8"
    },
    {
      "name": "org.ontobdc.domain.social.country.capability.query.list",
      "type": "file",
      "profile": "data-resource",
      "path": "../capability/country-list.py",
      "scheme": "file",
      "format": "py",
      "mediatype": "text/x-python"
    }
  ]
}
