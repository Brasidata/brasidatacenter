@prefix : <http://ontobdc.org/ontology/productivity/entity.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ns.ttl#> .
@base <http://ontobdc.org/ontology/productivity/entity.ttl#> .

<http://ontobdc.org/ontology/productivity/entity.ttl> rdf:type owl:Ontology ;
                                              owl:imports <http://ontobdc.org/ontology/domain/ns.ttl> .

:Contract rdf:type owl:NamedIndividual ,
                   obdc:DataEntity ;
          schema:description "Bilateral agreement with clauses, sections, and recurring legal terminology."@en ;
          schema:identifier "contract" ;
          obdc:hasDataEntityFacade :ContractDataEntityFacade ;
          schema:name "Contract"@en .

:ContractDataEntityFacade rdf:type owl:NamedIndividual ,
                                   obdc:DataEntityFacade ;
          schema:description "Facade with the display properties for the Contract entity."@en ;
          schema:identifier "contract_data_entity_facade" ;
          schema:name "Contract Data Entity Facade"@en .

:Invoice rdf:type owl:NamedIndividual ,
                  obdc:DataEntity ;
         schema:description "Commercial billing document with low section density and structured numeric listing."@en ;
         schema:identifier "invoice" ;
         obdc:hasDataEntityFacade :InvoiceDataEntityFacade ;
         schema:name "Invoice"@en .

:InvoiceDataEntityFacade rdf:type owl:NamedIndividual ,
                                  obdc:DataEntityFacade ;
         schema:description "Facade with the display properties for the Invoice entity."@en ;
         schema:identifier "invoice_data_entity_facade" ;
         schema:name "Invoice Data Entity Facade"@en .

:MeetingMinutes rdf:type owl:NamedIndividual ,
                         obdc:DataEntity ;
                schema:description "Meeting record with section markers, participant action listings, and lighter lexical recurrence."@en ;
                schema:identifier "meeting_minutes" ;
                obdc:hasDataEntityFacade :MeetingMinutesDataEntityFacade ;
                schema:name "Meeting Minutes"@en .

:MeetingMinutesDataEntityFacade rdf:type owl:NamedIndividual ,
                                         obdc:DataEntityFacade ;
                schema:description "Facade with the display properties for the Meeting Minutes entity."@en ;
                schema:identifier "meeting_minutes_data_entity_facade" ;
                schema:name "Meeting Minutes Data Entity Facade"@en .

:Proposal rdf:type owl:NamedIndividual ,
                   obdc:DataEntity ;
          schema:description "Commercial or technical proposal with moderate sections and moderate repeated persuasive vocabulary."@en ;
          schema:identifier "proposal" ;
          obdc:hasDataEntityFacade :ProposalDataEntityFacade ;
          schema:name "Proposal"@en .

:ProposalDataEntityFacade rdf:type owl:NamedIndividual ,
                                   obdc:DataEntityFacade ;
          schema:description "Facade with the display properties for the Proposal entity."@en ;
          schema:identifier "proposal_data_entity_facade" ;
          schema:name "Proposal Data Entity Facade"@en .

:PurchaseOrder rdf:type owl:NamedIndividual ,
                        obdc:DataEntity ;
               schema:description "Procurement request with list-heavy structure and moderate business vocabulary repetition."@en ;
               schema:identifier "purchase_order" ;
               obdc:hasDataEntityFacade :PurchaseOrderDataEntityFacade ;
               schema:name "Purchase Order"@en .

:PurchaseOrderDataEntityFacade rdf:type owl:NamedIndividual ,
                                        obdc:DataEntityFacade ;
               schema:description "Facade with the display properties for the Purchase Order entity."@en ;
               schema:identifier "purchase_order_data_entity_facade" ;
               schema:name "Purchase Order Data Entity Facade"@en .

:Receipt rdf:type owl:NamedIndividual ,
                  obdc:DataEntity ;
         schema:description "Short proof-of-payment document with very low page count and sparse sections."@en ;
         schema:identifier "receipt" ;
         obdc:hasDataEntityFacade :ReceiptDataEntityFacade ;
         schema:name "Receipt"@en .

:ReceiptDataEntityFacade rdf:type owl:NamedIndividual ,
                                  obdc:DataEntityFacade ;
         schema:description "Facade with the display properties for the Receipt entity."@en ;
         schema:identifier "receipt_data_entity_facade" ;
         schema:name "Receipt Data Entity Facade"@en .

:TechnicalReport rdf:type owl:NamedIndividual ,
                          obdc:DataEntity ;
                 schema:description "Analytical document with several sections, moderate lists, and denser repeated terminology."@en ;
                 schema:identifier "technical_report" ;
                 obdc:hasDataEntityFacade :TechnicalReportDataEntityFacade ;
                 schema:name "Technical Report"@en .

:TechnicalReportDataEntityFacade rdf:type owl:NamedIndividual ,
                                          obdc:DataEntityFacade ;
                 schema:description "Facade with the display properties for the Technical Report entity."@en ;
                 schema:identifier "technical_report_data_entity_facade" ;
                 schema:name "Technical Report Data Entity Facade"@en .

:TechnicalSpecification rdf:type owl:NamedIndividual ,
                                 obdc:DataEntity ;
                        schema:description "Structured specification with high section density and repeated domain terminology."@en ;
                        schema:identifier "technical_specification" ;
                        obdc:hasDataEntityFacade :TechnicalSpecificationDataEntityFacade ;
                        schema:name "Technical Specification"@en .

:TechnicalSpecificationDataEntityFacade rdf:type owl:NamedIndividual ,
                                                 obdc:DataEntityFacade ;
                        schema:description "Facade with the display properties for the Technical Specification entity."@en ;
                        schema:identifier "technical_specification_data_entity_facade" ;
                        schema:name "Technical Specification Data Entity Facade"@en .
