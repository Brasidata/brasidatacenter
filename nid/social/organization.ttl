
@prefix org: <http://www.w3.org/ns/org#> .
@prefix cv: <http://rdfs.org/resume-rdf/cv.rdfs#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rov: <http://www.w3.org/ns/regorg#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix bdc_org: <http://datacenter.app.br/nid/social/organization.ttl#> .
@base <http://datacenter.app.br/nid/social/organization.ttl> .

<http://datacenter.app.br/nid/social/organization.ttl> rdf:type owl:Ontology .

#################################################################
#    Data properties
#################################################################


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:DatatypeProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:DatatypeProperty ;
               owl:equivalentProperty schema:name .


###  http://www.w3.org/ns/regorg#legalName
rov:legalName rdf:type owl:DatatypeProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:DatatypeProperty .


###  https://schema.org/areaServed
schema:areaServed rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty .


###  https://schema.org/name
schema:name rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty .


#################################################################
#    Classes
#################################################################

###  http://datacenter.app.br/nid/social/organization.ttl#GithubAccount
bdc_org:GithubAccount rdf:type owl:Class .


###  http://datacenter.app.br/nid/social/organization.ttl#LinkedInAccount
bdc_org:LinkedInAccount rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/OnlineAccount
foaf:OnlineAccount rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class .


###  https://schema.org/WebSite
schema:WebSite rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://datacenter.app.br/nid/social/organization.ttl#Brasidata
bdc_org:Brasidata rdf:type owl:NamedIndividual ,
                           foaf:Organization ;
                  skos:altLabel "BRASIDATA ENGENHARIA"@pt-br ,
                                "BRASIDATA ENGINEERING"@en ;
                  rov:legalName "BRASIDATA CONSULTORIA EM ENGENHARIA, TECNOLOGIA, TREINAMENTO E DESENVOLVIMENTO DE SOFTWARE LTDA - ME" ;
                  schema:areaServed "Mundial"@pt-br ,
                                    "Worldwide"@en ;
                  schema:name "BRASIDATA CONSULTORIA EM ENGENHARIA E TECNOLOGIA" .


###  http://datacenter.app.br/nid/social/organization.ttl#GitHub
bdc_org:GitHub rdf:type owl:NamedIndividual ,
                        foaf:Organization ,
                        schema:WebSite ;
               rov:legalName "GitHub, Inc." ;
               foaf:homepage "https://github.com/"^^xsd:anyURI ;
               schema:areaServed "Mundial"@pt-br ,
                                 "Worldwide"@en ;
               schema:name "GitHub" .


###  http://datacenter.app.br/nid/social/organization.ttl#GithubAccount
bdc_org:GithubAccount rdf:type owl:NamedIndividual ,
                               foaf:OnlineAccount .


###  http://datacenter.app.br/nid/social/organization.ttl#LinkedIn
bdc_org:LinkedIn rdf:type owl:NamedIndividual ,
                          foaf:Organization ,
                          schema:WebSite ;
                 rov:legalName "LinkedIn Corporation" ;
                 foaf:homepage "https://www.linkedin.com/"^^xsd:anyURI ;
                 schema:areaServed "Mundial"@pt-br ,
                                   "Worldwide"@en ;
                 schema:name "LinkedIn" .


###  http://datacenter.app.br/nid/social/organization.ttl#LinkedInAccount
bdc_org:LinkedInAccount rdf:type owl:NamedIndividual ,
                                 foaf:OnlineAccount .


###  http://datacenter.app.br/nid/social/organization.ttl#Zigurat
bdc_org:Zigurat rdf:type owl:NamedIndividual ,
                         foaf:Organization ,
                         cv:EducationalOrg ;
                rov:legalName "ZIGURAT GLOBAL INSTITUTE OF TECHNOLOGY SL" ;
                schema:areaServed "Mundial"@pt-br ,
                                  "Worldwide"@en ;
                schema:name "ZIGURAT" .


bdc_org:PUC_Rio rdf:type owl:NamedIndividual ,
                           foaf:Organization ,
                           cv:EducationalOrg ;
                rov:legalName "PUC-Rio - Pontifícia Universidade Católica do Rio de Janeiro" ;
                schema:areaServed "Brasil"@pt-br ,
                                  "Brazil"@en ;
                schema:name "PUC-Rio - Pontifícia Universidade Católica do Rio de Janeiro"@pt-br ,
                                "Pontifical Catholic University of Rio de Janeiro"@en .

bdc_org:Uniabeu rdf:type owl:NamedIndividual ,
                           foaf:Organization ,
                           cv:EducationalOrg ;
                rov:legalName "ASSOCIACAO BRASILEIRA DE ENSINO UNIVERSITARIO ABEU" ;
                schema:areaServed "Brasil"@pt-br ,
                                  "Brazil"@en ;
                schema:name "UNIABEU" .


bdc_org:buildingSMART rdf:type owl:NamedIndividual ,
                           foaf:Organization ,
                           cv:EducationalOrg ;
                rov:legalName "buildingSMART International" ;
                schema:areaServed "Mundial"@pt-br ,
                                  "Worldwide"@en ;
                schema:name "buildingSMART International" .

