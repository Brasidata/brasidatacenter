
@prefix schema: <https://schema.org/> .
@prefix cv: <http://rdfs.org/resume-rdf/cv.rdfs#> .
@prefix role: <http://datacenter.app.br/nid/social/role.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@base <http://datacenter.app.br/nid/social/role.ttl#> .

<http://datacenter.app.br/nid/social/role.ttl> rdf:type owl:Ontology .


###  http://datacenter.app.br/nid/social/job.ttl#BIMCoordinatorProfile
role:BIMCoordinatorProfile rdf:type owl:Class ;
                              rdfs:subClassOf cv:Target ,
                                              schema:Occupation ;
                              rdfs:comment "BIM Coordinator with 10 years of experience in managing clash detection..."@en ,
                                           "Coordenador BIM com 10 anos de experiência em gestão de clash detection..."@pt-br ;
                              rdfs:label "BIM Coordinator"@en ,
                                         "Coordenador BIM"@pt-br .


###  http://datacenter.app.br/nid/social/job.ttl#BIMResearcherProfile
role:BIMResearcherProfile rdf:type owl:Class ;
                             rdfs:subClassOf cv:Target ,
                                             schema:Occupation ;
                             rdfs:comment "Engenheiro Pesquisador em Modelagem e Simulação de Informações"@pt-br ,
                                          "Research Engineer in Information Modeling and Simulation"@en ;
                             rdfs:label "Engenheiro Pesquisador"@pt-br ,
                                        "Research Engineer"@en .


###  http://datacenter.app.br/nid/social/job.ttl#BIMTechLeadProfile
role:BIMTechLeadProfile rdf:type owl:Class ;
                           rdfs:subClassOf cv:Target ,
                                           schema:Occupation ;
                           rdfs:comment "Líder Técnico focado em web semântica, parsers IFC e pipelines de dados..."@pt-br ,
                                        "Technical Lead focused on semantic web, IFC parsers, and data pipelines..."@en ;
                           rdfs:label "Líder Técnico"@pt-br ,
                                      "Tech Lead"@en .
