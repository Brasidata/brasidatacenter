###  http://datacenter.app.br/nid/social/job.ttl#CONTRACT
:CONTRACT rdf:type schema:DefinedTerm ;
                 schema:name "Contract"@en ,
                                        "Contrato"@pt-br ;
                schema:termCode "contract" ;
                schema:description "Relação de trabalho formalizada por contrato."@pt-br ,
                                   "Employment relationship formalized by a contract."@en ;
                schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue .


###  http://datacenter.app.br/nid/social/job.ttl#FULL_TIME
:FULL_TIME rdf:type schema:DefinedTerm ;
                 schema:name "Full-time"@en ,
                                        "Integral"@pt-br ;
                schema:termCode "full-time" ;
                schema:description "Jornada integral (carga horária padrão de tempo integral)."@pt-br ,
                                   "Full-time workload (standard full-time hours)."@en ;
                schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue .


###  http://datacenter.app.br/nid/social/job.ttl#INTERNSHIP
:INTERNSHIP rdf:type schema:DefinedTerm ;
                 schema:name "Internship"@en ,
                                        "Estágio"@pt-br ;
                schema:termCode "internship" ;
                schema:description "Vaga de estágio para estudantes, com foco em formação e aprendizagem."@pt-br ,
                                   "Internship position for students, primarily focused on training and learning."@en ;
                schema:inDefinedTermSet :EmploymentTypeEnumValue .


###  http://datacenter.app.br/nid/social/job.ttl#PART_TIME
:PART_TIME rdf:type schema:DefinedTerm ;
                 schema:name "Part-time"@en ,
                                        "Meio período"@pt-br ;
                schema:termCode "part-time" ;
                schema:description "Meio período; carga horária reduzida em relação ao tempo integral."@pt-br ,
                                   "Part-time workload; reduced hours compared to full-time."@en ;
                schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue .


###  http://datacenter.app.br/nid/social/job.ttl#SEASONAL
:SEASONAL rdf:type schema:DefinedTerm ;
                 schema:name "Seasonal"@en ,
                                        "Sazonal"@pt-br ;
                schema:termCode "seasonal" ;
                schema:description "Contrato sazonal vinculado a períodos específicos (ex.: alta temporada)."@pt-br ,
                                   "Seasonal employment tied to specific periods (e.g., peak season)."@en ;
                schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue .


###  http://datacenter.app.br/nid/social/job.ttl#TEMPORARY
:TEMPORARY rdf:type schema:DefinedTerm ;
                 schema:name "Temporary"@en ,
                                        "Temporário"@pt-br ;
                schema:termCode "temporary" ;
                schema:description "Contrato temporário com duração limitada e data fim definida."@pt-br ,
                                   "Temporary employment with limited duration and a defined end date."@en ;
                schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue .


:HYBRID rdf:type schema:DefinedTerm ;
                 schema:name "Hybrid"@en ,
                                        "Hybrid"@pt-br ;
                schema:termCode "hybrid" ;
                schema:description "Modelo híbrido: combina trabalho remoto e presencial."@pt-br ,
                                   "Hybrid arrangement: combines remote and on-site work."@en ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue .


:REMOTE rdf:type schema:DefinedTerm ;
                 schema:name "Remote"@en ,
                                        "Remoto"@pt-br ;
                schema:termCode "remote" ;
                schema:description "Trabalho remoto: atividades executadas à distância, sem presença física contínua."@pt-br ,
                                   "Remote work: duties performed off-site without continuous physical presence."@en ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue .


:ONSITE rdf:type schema:DefinedTerm ;
                 schema:name "Onsite"@en ,
                                        "Onsite"@pt-br ;
                schema:termCode "onsite", "on-site" ;
                schema:description "Trabalho presencial: atividades realizadas no local do empregador."@pt-br ,
                                   "On-site work: duties performed at the employer's location."@en ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue .


:SYNCHRONOUS rdf:type schema:DefinedTerm ;
                 schema:name "Synchronous"@en ,
                                        "Sincrono"@pt-br ;
                schema:termCode "synchronous" ;
                schema:description "Comunicação síncrona: interação em tempo real (ex.: reuniões ao vivo, chamadas)."@pt-br ,
                                   "Synchronous communication: real-time interaction (e.g., live meetings, calls)."@en ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue .


:ASYNCHRONOUS rdf:type schema:DefinedTerm ;
                 schema:name "Asynchronous"@en ,
                                        "Assincrono"@pt-br ;
                schema:termCode "asynchronous" ;
                schema:description "Comunicação assíncrona: interação não simultânea (ex.: e-mail, tickets, mensagens)."@pt-br ,
                                   "Asynchronous communication: non-real-time interaction (e.g., email, tickets, messages)."@en ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue .


:UNKNOWN rdf:type schema:DefinedTerm ;
                 schema:name "Unknown"@en ,
                                        "Desconhecido"@pt-br ;
                schema:termCode "unknown" ;
                schema:description "Usado quando o valor não é informado ou não pode ser inferido."@pt-br ,
                                   "Used when the value is not provided or cannot be inferred."@en ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue .


