###  http://datacenter.app.br/nid/social/job.ttl#hasAchievement
bdc_job:hasAchievement rdf:type owl:ObjectProperty ;
                       rdfs:label "has Achievement"@en ,
                                  "has Achievement"@pt-br .


###  http://datacenter.app.br/nid/social/job.ttl#hasSkillGroup
bdc_job:hasSkillGroup rdf:type owl:ObjectProperty ;
                      rdfs:label "has Skill Group"@en ,
