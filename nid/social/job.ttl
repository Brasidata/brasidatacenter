###  http://datacenter.app.br/nid/social/job.ttl#ASYNCHRONOUS
obdc_job:ASYNCHRONOUS rdf:type owl:NamedIndividual ,
                               schema:DefinedTerm ;
                      schema:description "Asynchronous communication: non-real-time interaction (e.g., email, tickets, messages)."@en ,
                                         "Comunicação assíncrona: interação não simultânea (ex.: e-mail, tickets, mensagens)."@pt-br ;
                      schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue ;
                      schema:name "Assincrono"@pt-br ,
                                  "Asynchronous"@en ;
                      schema:termCode "asynchronous" .


###  http://datacenter.app.br/nid/social/job.ttl#CONTRACT
obdc_job:CONTRACT rdf:type owl:NamedIndividual ,
                           schema:DefinedTerm ;
                  schema:description "Employment relationship formalized by a contract."@en ,
                                     "Relação de trabalho formalizada por contrato."@pt-br ;
                  schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue ;
                  schema:name "Contract"@en ,
                              "Contrato"@pt-br ;
                  schema:termCode "contract" .


###  http://datacenter.app.br/nid/social/job.ttl#EmploymentTypeEnumValue
obdc_job:EmploymentTypeEnumValue rdf:type owl:NamedIndividual ,
                                          schema:DefinedTermSet ;
                                 schema:description "Controlled vocabulary for employment/vínculo types used in job postings."@en ,
                                                    "Vocabulário controlado de tipos de vínculo/contratação usados em vagas."@pt-br ;
                                 schema:name "Employment type"@en ,
                                             "Tipo de vínculo"@pt-br ;
                                 schema:terms obdc_job:CONTRACT ,
                                              obdc_job:FULL_TIME ,
                                              obdc_job:INTERNSHIP ,
                                              obdc_job:PART_TIME ,
                                              obdc_job:SEASONAL ,
                                              obdc_job:TEMPORARY .


###  http://datacenter.app.br/nid/social/job.ttl#FULL_TIME
obdc_job:FULL_TIME rdf:type owl:NamedIndividual ,
                            schema:DefinedTerm ;
                   schema:description "Full-time workload (standard full-time hours)."@en ,
                                      "Jornada integral (carga horária padrão de tempo integral)."@pt-br ;
                   schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue ;
                   schema:name "Full-time"@en ,
                               "Integral"@pt-br ;
                   schema:termCode "full-time" .


###  http://datacenter.app.br/nid/social/job.ttl#HYBRID
obdc_job:HYBRID rdf:type owl:NamedIndividual ,
                         schema:DefinedTerm ;
                schema:description "Hybrid arrangement: combines remote and on-site work."@en ,
                                   "Modelo híbrido: combina trabalho remoto e presencial."@pt-br ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue ;
                schema:name "Hybrid"@en ,
                            "Hybrid"@pt-br ;
                schema:termCode "hybrid" .


###  http://datacenter.app.br/nid/social/job.ttl#INTERNSHIP
obdc_job:INTERNSHIP rdf:type owl:NamedIndividual ,
                             schema:DefinedTerm ;
                    schema:description "Internship position for students, primarily focused on training and learning."@en ,
                                       "Vaga de estágio para estudantes, com foco em formação e aprendizagem."@pt-br ;
                    schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue ;
                    schema:name "Estágio"@pt-br ,
                                "Internship"@en ;
                    schema:termCode "internship" .


###  http://datacenter.app.br/nid/social/job.ttl#JobLocationTypeEnumValue
obdc_job:JobLocationTypeEnumValue rdf:type owl:NamedIndividual ,
                                           schema:DefinedTermSet ;
                                  schema:description "Controlled vocabulary for where the work is performed (on-site, hybrid, remote, unknown)."@en ,
                                                     "Vocabulário controlado para onde o trabalho é realizado (presencial, híbrido, remoto, desconhecido)."@pt-br ;
                                  schema:name "Tipo de local de trabalho"@pt-br ,
                                              "Work location type"@en ;
                                  schema:terms obdc_job:HYBRID ,
                                               obdc_job:ONSITE ,
                                               obdc_job:REMOTE ,
                                               obdc_job:UNKNOWN .


###  http://datacenter.app.br/nid/social/job.ttl#ONSITE
obdc_job:ONSITE rdf:type owl:NamedIndividual ,
                         schema:DefinedTerm ;
                schema:description "On-site work: duties performed at the employer's location."@en ,
                                   "Trabalho presencial: atividades realizadas no local do empregador."@pt-br ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue ;
                schema:name "Onsite"@en ,
                            "Onsite"@pt-br ;
                schema:termCode "on-site" ,
                                "onsite" .


###  http://datacenter.app.br/nid/social/job.ttl#PART_TIME
obdc_job:PART_TIME rdf:type owl:NamedIndividual ,
                            schema:DefinedTerm ;
                   schema:description "Meio período; carga horária reduzida em relação ao tempo integral."@pt-br ,
                                      "Part-time workload; reduced hours compared to full-time."@en ;
                   schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue ;
                   schema:name "Meio período"@pt-br ,
                               "Part-time"@en ;
                   schema:termCode "part-time" .


###  http://datacenter.app.br/nid/social/job.ttl#REMOTE
obdc_job:REMOTE rdf:type owl:NamedIndividual ,
                         schema:DefinedTerm ;
                schema:description "Remote work: duties performed off-site without continuous physical presence."@en ,
                                   "Trabalho remoto: atividades executadas à distância, sem presença física contínua."@pt-br ;
                schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue ;
                schema:name "Remote"@en ,
                            "Remoto"@pt-br ;
                schema:termCode "remote" .


###  http://datacenter.app.br/nid/social/job.ttl#SEASONAL
obdc_job:SEASONAL rdf:type owl:NamedIndividual ,
                           schema:DefinedTerm ;
                  schema:description "Contrato sazonal vinculado a períodos específicos (ex.: alta temporada)."@pt-br ,
                                     "Seasonal employment tied to specific periods (e.g., peak season)."@en ;
                  schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue ;
                  schema:name "Sazonal"@pt-br ,
                              "Seasonal"@en ;
                  schema:termCode "seasonal" .


###  http://datacenter.app.br/nid/social/job.ttl#SYNCHRONOUS
obdc_job:SYNCHRONOUS rdf:type owl:NamedIndividual ,
                              schema:DefinedTerm ;
                     schema:description "Comunicação síncrona: interação em tempo real (ex.: reuniões ao vivo, chamadas)."@pt-br ,
                                        "Synchronous communication: real-time interaction (e.g., live meetings, calls)."@en ;
                     schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue ;
                     schema:name "Sincrono"@pt-br ,
                                 "Synchronous"@en ;
                     schema:termCode "synchronous" .


###  http://datacenter.app.br/nid/social/job.ttl#TEMPORARY
obdc_job:TEMPORARY rdf:type owl:NamedIndividual ,
                            schema:DefinedTerm ;
                   schema:description "Contrato temporário com duração limitada e data fim definida."@pt-br ,
                                      "Temporary employment with limited duration and a defined end date."@en ;
                   schema:inDefinedTermSet obdc_job:EmploymentTypeEnumValue ;
                   schema:name "Temporary"@en ,
                               "Temporário"@pt-br ;
                   schema:termCode "temporary" .


###  http://datacenter.app.br/nid/social/job.ttl#UNKNOWN
obdc_job:UNKNOWN rdf:type owl:NamedIndividual ,
                          schema:DefinedTerm ;
                 schema:description "Usado quando o valor não é informado ou não pode ser inferido."@pt-br ,
                                    "Used when the value is not provided or cannot be inferred."@en ;
                 schema:inDefinedTermSet obdc_job:JobLocationTypeEnumValue ;
                 schema:name "Desconhecido"@pt-br ,
                             "Unknown"@en ;
                 schema:termCode "unknown" .


