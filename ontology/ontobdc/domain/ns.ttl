@prefix : <http://ontobdc.org/ontology/domain/ns.ttl#> .
@prefix ct: <http://standards.iso.org/iso/21597/-1/ed-1/en/Container#> .
@prefix cpms: <https://doi.org/10.2139/ssrn.2062696#> .
@prefix err: <http://www.w3.org/2010/02/rdfa/errors#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontouml: <http://w3id.org/ontouml#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix function: <http://w3id.org/function/ontology#> .
@prefix ws: <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl#> .
@prefix ibim: <https://infobim.org/ontology/ns#> .
@base <http://ontobdc.org/ontology/domain/ns.ttl#> .

<http://ontobdc.org/ontology/domain/ns.ttl> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://ontobdc.org/ontology/domain/ns.ttl#pythonType
:pythonType rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://w3id.org/function/ontology#returns
function:returns rdf:type owl:AnnotationProperty .


###  http://w3id.org/ontouml#name
ontouml:name rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://ontobdc.org/ontology/domain/ns.ttl#belongsToDataContainer
:belongsToDataContainer rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf dcterms:isPartOf ;
                        rdfs:domain :EntityDataset ;
                        rdfs:range :DataContainer ;
                        ontouml:name "Belongs to data container"@en ;
                        rdfs:comment "The entity dataset belongs to the specified data container."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#hasDataContainer
:hasDataContainer rdf:type owl:ObjectProperty ;
                  rdfs:domain :DataStorage ;
                  rdfs:range :DataContainer ;
                  ontouml:name "Has data container"@en ;
                  rdfs:comment "The data storage capability has the specified data container."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#hasDataEntity
:hasDataEntity rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf prov:hadMember ;
               rdfs:domain :EntityDataset ;
               rdfs:range :DataEntity ;
               ontouml:name "Has data entity"@en ;
               rdfs:comment "The dataset contains the specific data entity."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#hasDocumentType
:hasDocumentType rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf schema:additionalType ;
                 rdfs:domain :DataEntity ;
                 rdfs:range :DocumentType ;
                 ontouml:name "Has document type"@en ;
                 rdfs:comment "Relates a data entity to its document type classification."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#hasEntityDataset
:hasEntityDataset rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf dcterms:hasPart ;
                  rdfs:domain :DataContainer ;
                  rdfs:range :EntityDataset ;
                  ontouml:name "Has entity dataset"@en ;
                  rdfs:comment "The data container has the specified entity dataset."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#hasFileGroupingScheme
:hasFileGroupingScheme rdf:type owl:ObjectProperty ;
                       rdfs:domain :ProjectManagementFramework ;
                       rdfs:range :FileGroupingScheme ;
                       ontouml:name "Has file grouping scheme"@en ;
                       rdfs:comment "Associates a project management framework application with a renderer-neutral scheme for grouping candidate files by semantic criteria."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#hasFileGroup
:hasFileGroup rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf dcterms:hasPart ;
              rdfs:domain :FileGroupingScheme ;
              rdfs:range :FileGroup ;
              ontouml:name "Has file group"@en ;
              rdfs:comment "Associates a file grouping scheme with one of its semantic file groups."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#matchesMediaType
:matchesMediaType rdf:type owl:ObjectProperty ;
                  rdfs:domain :FileGroup ;
                  rdfs:range dcterms:MediaType ;
                  ontouml:name "Matches media type"@en ;
                  rdfs:comment "Declares a media-type criterion for a file group. MIME detection and any filename-extension fallback are runtime concerns and are not part of this semantic contract."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#usesProjectManagementFramework
:usesProjectManagementFramework rdf:type owl:ObjectProperty ;
                                rdfs:domain [
                                    rdf:type owl:Class ;
                                    owl:unionOf ( ws:WorkStream ibim:IfcWorkSchedule )
                                ] ;
                                rdfs:range :ProjectManagementFramework ;
                                ontouml:name "Uses project management framework"@en ;
                                rdfs:comment "Associates a Work Stream or IFC Work Schedule with a project management framework. The property is intentionally non-functional, allowing one entity to use multiple frameworks."@en .


###  http://purl.org/dc/terms/hasPart
dcterms:hasPart rdf:type owl:ObjectProperty .


###  http://purl.org/dc/terms/isPartOf
dcterms:isPartOf rdf:type owl:ObjectProperty .


###  http://schema.org/additionalType
schema:additionalType rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#hadMember
prov:hadMember rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://ontobdc.org/ontology/domain/ns.ttl#documentTypeVectorValue
:documentTypeVectorValue rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf schema:value ;
                         rdfs:domain :DocumentType ;
                         rdfs:range xsd:string ;
                         ontouml:name "Document type vector value"@en ;
                         rdfs:comment "Serialized vector value used to represent a document type profile."@en .


###  http://schema.org/value
schema:value rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  https://doi.org/10.2139/ssrn.2062696#ManagementTechnique
cpms:ManagementTechnique rdf:type owl:Class ;
                         rdfs:label "Management Technique"@en ;
                         rdfs:isDefinedBy <https://doi.org/10.2139/ssrn.2062696> ;
                         rdfs:comment "Management-technique dimension of the Construction Project Management System (CPMS) ontological framework."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#DataContainer
:DataContainer rdf:type owl:Class ,
                        :SurfaceableEntity ;
               rdfs:subClassOf ct:ContainerDescription ,
                               dcat:Catalog ;
               ontouml:name "Data container"@en ;
               rdfs:comment "A catalog or container that groups and organizes entity datasets."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#DataEntity
:DataEntity rdf:type owl:Class ;
            rdfs:subClassOf prov:Entity ;
            ontouml:name "Data entity"@en ;
            rdfs:comment "An individual data entity or resource."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#DataStorage
:DataStorage rdf:type owl:Class ;
             rdfs:subClassOf function:Function ,
                             dcat:DataService ;
             ontouml:name "Data storage"@en ;
             rdfs:comment "The data storage capability that manages data containers and semantic storage."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#DocumentType
:DocumentType rdf:type owl:Class ;
              rdfs:subClassOf schema:DefinedTerm ;
              ontouml:name "Document type"@en ;
              rdfs:comment "A controlled document type used to classify data entities."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#EntityDataset
:EntityDataset rdf:type owl:Class ;
               rdfs:subClassOf ct:Folder ,
                               dcat:Dataset ;
               ontouml:name "Entity dataset"@en ;
               rdfs:comment "A dataset representing a collection of related data entities."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#FileGroupingScheme
:FileGroupingScheme rdf:type owl:Class ;
                    ontouml:name "File grouping scheme"@en ;
                    rdfs:comment "Renderer-neutral scheme that organizes a finite candidate set of files into semantic groups for a project management framework application."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#FileGroup
:FileGroup rdf:type owl:Class ;
           ontouml:name "File group"@en ;
           rdfs:comment "Semantic group within a file grouping scheme. Membership may be selected by one or more declared criteria such as media type."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#ResidualFileGroup
:ResidualFileGroup rdf:type owl:Class ;
                   rdfs:subClassOf :FileGroup ;
                   ontouml:name "Residual file group"@en ;
                   rdfs:comment "Residual group whose members are candidate files not matched by any non-residual sibling FileGroup in the same FileGroupingScheme. Membership is evaluated over the finite candidate set by deterministic runtime logic and must not be interpreted as an OWL complement."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#ExecutionContext
:ExecutionContext rdf:type owl:Class ;
                  ontouml:name "Execution context"@en ;
                  rdfs:comment "The execution context that stores runtime parameters for a CLI interaction."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#IncomingDatasetParameter
:IncomingDatasetParameter rdf:type owl:Class ;
                          rdfs:subClassOf function:Parameter ;
                          dcterms:identifier "org.ontobdc.domain.storage.capability.incoming.dataset" ;
                          ontouml:name "Incoming Dataset"@en ;
                          rdfs:comment "Dataset repository instance"@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#OutputSchema
:OutputSchema rdf:type owl:Class ;
              rdfs:subClassOf function:Output ;
              dcterms:identifier "ooutput_schema" ;
              ontouml:name "Output schema"@en ;
              rdfs:comment "The schema of the output data produced by the query execution."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#ProjectManagementFramework
:ProjectManagementFramework rdf:type owl:Class ;
                            rdfs:subClassOf cpms:ManagementTechnique ;
                            ontouml:name "Project management framework"@en ;
                            rdfs:label "Project Management Framework"@en ;
                            rdfs:comment "A management technique or structured framework used to organize, guide, or support the management of project work."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#QueryCapability
:QueryCapability rdf:type owl:Class ;
                 rdfs:subClassOf schema:SoftwareApplication ,
                                 function:Function ;
                 function:returns :QueryResponse ;
                 ontouml:name "Query capability"@en ;
                 rdfs:comment "Executes a query over a declared data or semantic context."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#SurfaceableEntity
:SurfaceableEntity rdf:type owl:Class ;
                   ontouml:name "Surfaceable entity"@en ;
                   rdfs:comment "Marks an entity class whose instances are eligible for a direct representation (a Tile) on an OntoBDC presentation surface."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#TransformationCapability
:TransformationCapability rdf:type owl:Class ;
                          rdfs:subClassOf schema:SoftwareApplication ,
                                          function:Function ;
                          function:returns :TransformationResponse ;
                          ontouml:name "Transformation capability"@en ;
                          rdfs:comment "Executes a transformation over a declared data or semantic context."@en .


###  http://purl.org/dc/terms/MediaType
dcterms:MediaType rdf:type owl:Class .


###  http://schema.org/DefinedTerm
schema:DefinedTerm rdf:type owl:Class .


###  http://schema.org/SoftwareApplication
schema:SoftwareApplication rdf:type owl:Class .


###  http://schema.org/SoftwareSourceCode
schema:SoftwareSourceCode rdf:type owl:Class .


###  http://schema.org/actionStatus
schema:actionStatus rdf:type owl:Class .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Container#ContainerDescription
ct:ContainerDescription rdf:type owl:Class .


###  http://standards.iso.org/iso/21597/-1/ed-1/en/Container#Folder
ct:Folder rdf:type owl:Class .


###  http://w3id.org/function/ontology#Function
function:Function rdf:type owl:Class .


###  http://w3id.org/function/ontology#Output
function:Output rdf:type owl:Class .


###  http://w3id.org/function/ontology#Parameter
function:Parameter rdf:type owl:Class .


###  http://www.w3.org/2010/02/rdfa/errors#Error
err:Error rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#Catalog
dcat:Catalog rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#DataService
dcat:DataService rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#Dataset
dcat:Dataset rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .

###  http://ontobdc.org/ontology/domain/ns.ttl#entityAlias
:entityAlias rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf skos:altLabel ,
                                schema:alternateName ;
             rdfs:domain :DataEntity ;
             rdfs:range xsd:string ;
             ontouml:name "Entity alias"@en ;
             rdfs:comment "A short name or common alias for the data entity."@en .