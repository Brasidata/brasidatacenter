@prefix : <http://datacenter.app.br/ontology/ontobdc/domain/tile.ttl#> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ns.ttl#> .
@prefix view: <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#> .
@prefix ws: <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/ontobdc/domain/tile.ttl>
    a owl:Ontology ;
    rdfs:label "OntoBDC Tile Presentation Ontology"@en ;
    rdfs:comment "Renderer-neutral semantic descriptions of the Tiles currently supplied by OntoBDC View. This ontology describes presentation intent and data requirements; HTML custom-element names and Flutter widget classes remain renderer implementation details."@en ;
    schema:description "Generic OntoBDC Tile contracts. Domain extensions such as InfoBIM must define their own Tiles in separate ontologies and may reuse these contracts without making OntoBDC depend on the extension."@en ;
    owl:imports <http://ontobdc.org/ontology/domain/ns.ttl> ,
                <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl> ,
                <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl> ;
    rdfs:seeAlso <https://www.w3.org/TR/shacl12-ui/> .

#################################################################
# Generic Tile contract
#################################################################

:ContentTile a owl:Class ;
    rdfs:subClassOf view:Tile ;
    rdfs:label "Content Tile"@en ;
    rdfs:comment "Tile whose presentation is resolved from a focus data resource and its semantic type/properties."@en .

:ChromeTile a owl:Class ;
    rdfs:subClassOf view:Tile ;
    rdfs:label "Chrome Tile"@en ;
    rdfs:comment "Tile that belongs to the presentation chrome and is selected by Tile class rather than by a focus DataEntity."@en .

:TilePresentationContract a owl:Class ;
    rdfs:label "Tile Presentation Contract"@en ;
    rdfs:comment "Renderer-neutral declaration connecting a Tile kind with an optional SHACL UI node shape and presentation behavior."@en .

:forTileClass a owl:ObjectProperty ;
    rdfs:domain :TilePresentationContract ;
    rdfs:range owl:Class ;
    rdfs:label "for tile class"@en .

:usesNodeShape a owl:ObjectProperty ;
    rdfs:domain :TilePresentationContract ;
    rdfs:range sh:NodeShape ;
    rdfs:label "uses node shape"@en .

:usesSupportProfile a owl:ObjectProperty ;
    rdfs:domain :TilePresentationContract ;
    rdfs:range view:PresentationSupportProfile ;
    rdfs:label "uses support profile"@en ;
    rdfs:comment "Presentation envelope requested by this semantic Tile contract. Kept separate from view:hasSupportProfile, whose domain is a runtime presentation Component."@en .

:opensPresentationClass a owl:ObjectProperty ;
    rdfs:domain :TilePresentationContract ;
    rdfs:range owl:Class ;
    rdfs:label "opens presentation class"@en ;
    rdfs:comment "Detailed presentation class opened by an explicit Tile action. The detailed presentation is modeled separately from the Tile's own SHACL UI shape."@en .

:defaultClosed a owl:DatatypeProperty ;
    rdfs:domain :TilePresentationContract ;
    rdfs:range xsd:boolean ;
    rdfs:label "default closed"@en ;
    rdfs:comment "Whether a renderer should initially keep the Tile closed/hidden until explicitly opened. This is presentation behavior, not CSS visibility."@en .

:expandable a owl:DatatypeProperty ;
    rdfs:domain :TilePresentationContract ;
    rdfs:range xsd:boolean ;
    rdfs:label "expandable"@en ;
    rdfs:comment "Whether the Tile has an internal expanded presentation state in addition to its compact state."@en .

#################################################################
# Content Tiles currently implemented by OntoBDC View
#################################################################

:DataContainerTile a owl:Class ; rdfs:subClassOf :ContentTile ; rdfs:label "Data Container Tile"@en ; rdfs:comment "Summary presentation of an obdc:DataContainer."@en .
:FileTreeTile a owl:Class ; rdfs:subClassOf :ContentTile ; rdfs:label "File Tree Tile"@en ; rdfs:comment "Hierarchical presentation of the files known to an obdc:FileTree resource."@en .
:GenericFileTile a owl:Class ; rdfs:subClassOf :ContentTile ; rdfs:label "Generic File Tile"@en ; rdfs:comment "Metadata-oriented presentation for an obdc:GenericFile when no specialized preview is available."@en .
:ImageFileTile a owl:Class ; rdfs:subClassOf :ContentTile ; rdfs:label "Image File Tile"@en ; rdfs:comment "Image preview presentation for an obdc:ImageFile."@en .
:PdfFileTile a owl:Class ; rdfs:subClassOf :ContentTile ; rdfs:label "PDF File Tile"@en ; rdfs:comment "PDF preview presentation for an obdc:PdfFile."@en .
:CsvFileTile a owl:Class ; rdfs:subClassOf :ContentTile ; rdfs:label "CSV File Tile"@en ; rdfs:comment "Tabular preview presentation for an obdc:CsvFile."@en .
:WorkStreamTile a owl:Class ;
    rdfs:subClassOf :ContentTile ;
    rdfs:label "WorkStream Tile"@en ;
    rdfs:comment "Presentation of a WorkStream entity with a compact identity/description state, an expandable 5W2H field state, and an explicit action that opens the detailed WorkStream presentation. The Tile contract remains generic OntoBDC presentation infrastructure even though the focus class is defined by the productivity ontology."@en .

#################################################################
# Detailed presentations opened by Tiles
#################################################################

:WorkStreamDetailedPresentation a owl:Class ;
    rdfs:subClassOf view:Component ;
    rdfs:label "WorkStream Detailed Presentation"@en ;
    schema:description "Detailed presentation opened from a WorkStream Tile. It presents the WorkStream dimensions and, for each dimension, separates resources already related to the dimension from resources merely found in the container, provides hierarchical resource navigation and a selected-resource preview, and exposes annotation actions for the selected resource."@en ;
    rdfs:comment "The semantic contract describes presentation responsibilities without prescribing browser-specific orientation. The current browser renderer materializes resource navigation beside the preview and annotation controls below the preview."@en .

#################################################################
# Chrome Tiles currently implemented by OntoBDC View
#################################################################

:LogoTile a owl:Class ; rdfs:subClassOf :ChromeTile ; owl:equivalentClass view:LogoTile ; rdfs:label "Logo Tile"@en .
:ThemeTile a owl:Class ; rdfs:subClassOf :ChromeTile ; owl:equivalentClass view:ThemeTile ; rdfs:label "Theme Tile"@en .
:LanguageTile a owl:Class ; rdfs:subClassOf :ChromeTile ; owl:equivalentClass view:LanguageTile ; rdfs:label "Language Tile"@en .
:PhotoTile a owl:Class ; rdfs:subClassOf :ChromeTile ; owl:equivalentClass view:PhotoTile ; rdfs:label "Photo Tile"@en .

#################################################################
# SHACL / SHACL UI shapes for content Tiles
#################################################################

:DataContainerTileShape a sh:NodeShape ;
    sh:targetClass obdc:DataContainer ; sh:name "Data Container"@en ;
    sh:property
        [ sh:path dcterms:title ; sh:name "Title"@en ; sh:order 10 ; shui:viewer shui:LabelViewer ; shui:propertyRole shui:LabelRole ],
        [ sh:path dcterms:description ; sh:name "Description"@en ; sh:order 20 ; shui:viewer shui:LiteralViewer ] .

:FileTreeTileShape a sh:NodeShape ;
    sh:targetClass obdc:FileTree ; sh:name "Files"@en ;
    sh:property [ sh:path obdc:filePath ; sh:name "File path"@en ; sh:order 10 ; shui:viewer shui:LiteralViewer ] .

:GenericFileTileShape a sh:NodeShape ;
    sh:targetClass obdc:GenericFile ; sh:name "File"@en ;
    sh:property
        [ sh:path dcterms:title ; sh:name "Name"@en ; sh:order 10 ; shui:viewer shui:LabelViewer ; shui:propertyRole shui:LabelRole ],
        [ sh:path obdc:filePath ; sh:name "Path"@en ; sh:order 20 ; shui:viewer shui:LiteralViewer ] .

:ImageFileTileShape a sh:NodeShape ;
    sh:targetClass obdc:ImageFile ; sh:name "Image"@en ;
    sh:property
        [ sh:path dcterms:title ; sh:name "Name"@en ; sh:order 10 ; shui:viewer shui:LabelViewer ; shui:propertyRole shui:LabelRole ],
        [ sh:path obdc:filePath ; sh:name "Image"@en ; sh:order 20 ; shui:viewer shui:ImageViewer ] .

:PdfFileTileShape a sh:NodeShape ;
    sh:targetClass obdc:PdfFile ; sh:name "PDF"@en ;
    sh:property
        [ sh:path dcterms:title ; sh:name "Name"@en ; sh:order 10 ; shui:viewer shui:LabelViewer ; shui:propertyRole shui:LabelRole ],
        [ sh:path obdc:filePath ; sh:name "PDF resource"@en ; sh:order 20 ; shui:viewer shui:HyperlinkViewer ] .

:CsvFileTileShape a sh:NodeShape ;
    sh:targetClass obdc:CsvFile ; sh:name "CSV"@en ;
    sh:property
        [ sh:path dcterms:title ; sh:name "Name"@en ; sh:order 10 ; shui:viewer shui:LabelViewer ; shui:propertyRole shui:LabelRole ],
        [ sh:path obdc:filePath ; sh:name "Tabular resource"@en ; sh:order 20 ; shui:viewer shui:ValueTableViewer ] .

# The first three properties form the compact Tile. The seven 5W2H
# properties correspond to the FacadeFields exposed by the expanded state.
:WorkStreamTileShape a sh:NodeShape ;
    sh:targetClass ws:WorkStream ; sh:name "WorkStream"@en ;
    rdfs:comment "Title, identifier and Description form the compact WorkStream presentation. What, Why, Who, Where, When, How and How Much correspond to the populated 5W2H FacadeFields exposed when the Tile is expanded."@en ;
    rdfs:seeAlso <http://datacenter.app.br/ontology/productivity/entity/work_stream/facade.ttl> ;
    sh:property
        [ sh:path dcterms:title ; sh:name "Title"@en ; sh:order 10 ; shui:viewer shui:LabelViewer ; shui:propertyRole shui:LabelRole ],
        [ sh:path dcterms:identifier ; sh:name "Identifier"@en ; sh:order 20 ; shui:viewer shui:LiteralViewer ],
        [ sh:path dcterms:description ; sh:name "Description"@en ; sh:order 30 ; shui:viewer shui:LiteralViewer ],
        [ sh:path ws:what ; sh:name "What"@en ; sh:order 100 ; shui:viewer shui:LiteralViewer ],
        [ sh:path ws:why ; sh:name "Why"@en ; sh:order 110 ; shui:viewer shui:LiteralViewer ],
        [ sh:path ws:who ; sh:name "Who"@en ; sh:order 120 ; shui:viewer shui:LabelViewer ],
        [ sh:path ws:where ; sh:name "Where"@en ; sh:order 130 ; shui:viewer shui:LabelViewer ],
        [ sh:path ws:when ; sh:name "When"@en ; sh:order 140 ; shui:viewer shui:LiteralViewer ],
        [ sh:path ws:how ; sh:name "How"@en ; sh:order 150 ; shui:viewer shui:LiteralViewer ],
        [ sh:path ws:howMuch ; sh:name "How Much"@en ; sh:order 160 ; shui:viewer shui:LiteralViewer ] .

#################################################################
# Contracts and support profiles mirror active Component behavior
#################################################################

:DataContainerTileContract a :TilePresentationContract ; :forTileClass :DataContainerTile ; :usesNodeShape :DataContainerTileShape ; :defaultClosed false ; :usesSupportProfile :DataContainerTileSupport .
:DataContainerTileSupport a view:PresentationSupportProfile ; view:minColumns 1 ; view:maxColumns 6 ; view:minRows 2 ; view:maxRows 2 .

:FileTreeTileContract a :TilePresentationContract ; :forTileClass :FileTreeTile ; :usesNodeShape :FileTreeTileShape ; :defaultClosed false ; :usesSupportProfile :FileTreeTileSupport .
:FileTreeTileSupport a view:PresentationSupportProfile ; view:minColumns 6 ; view:minRows 4 .

:GenericFileTileContract a :TilePresentationContract ; :forTileClass :GenericFileTile ; :usesNodeShape :GenericFileTileShape ; :defaultClosed true ; :usesSupportProfile :GenericFileTileSupport .
:GenericFileTileSupport a view:PresentationSupportProfile ; view:minColumns 6 ; view:minRows 5 .

:ImageFileTileContract a :TilePresentationContract ; :forTileClass :ImageFileTile ; :usesNodeShape :ImageFileTileShape ; :defaultClosed true ; :usesSupportProfile :ImageFileTileSupport .
:ImageFileTileSupport a view:PresentationSupportProfile ; view:minColumns 6 ; view:minRows 5 .

:PdfFileTileContract a :TilePresentationContract ; :forTileClass :PdfFileTile ; :usesNodeShape :PdfFileTileShape ; :defaultClosed true ; :usesSupportProfile :PdfFileTileSupport .
:PdfFileTileSupport a view:PresentationSupportProfile ; view:minColumns 6 ; view:minRows 5 .

:CsvFileTileContract a :TilePresentationContract ; :forTileClass :CsvFileTile ; :usesNodeShape :CsvFileTileShape ; :defaultClosed true ; :usesSupportProfile :CsvFileTileSupport .
:CsvFileTileSupport a view:PresentationSupportProfile ; view:minColumns 6 ; view:minRows 5 .

:WorkStreamTileContract a :TilePresentationContract ;
    :forTileClass :WorkStreamTile ;
    :usesNodeShape :WorkStreamTileShape ;
    :defaultClosed false ;
    :expandable true ;
    :opensPresentationClass :WorkStreamDetailedPresentation ;
    :usesSupportProfile :WorkStreamTileSupport ;
    schema:description "The compact state presents title, identifier and Description. Expansion exposes populated 5W2H fields. The explicit open action leads to the detailed WorkStream presentation."@en .

# Three rows are the current compact baseline. Expansion is content-driven
# and may grow beyond it, therefore maxRows is intentionally not asserted.
:WorkStreamTileSupport a view:PresentationSupportProfile ;
    view:minColumns 6 ;
    view:minRows 3 ;
    view:preferredRows 3 .

:LogoTileContract a :TilePresentationContract ; :forTileClass :LogoTile ; :defaultClosed false .
:ThemeTileContract a :TilePresentationContract ; :forTileClass :ThemeTile ; :defaultClosed false .
:LanguageTileContract a :TilePresentationContract ; :forTileClass :LanguageTile ; :defaultClosed false .
:PhotoTileContract a :TilePresentationContract ; :forTileClass :PhotoTile ; :defaultClosed false .

#################################################################
# Contract validation
#################################################################

:TilePresentationContractShape a sh:NodeShape ;
    sh:targetClass :TilePresentationContract ;
    sh:property
        [ sh:path :forTileClass ; sh:minCount 1 ; sh:maxCount 1 ],
        [ sh:path :usesNodeShape ; sh:maxCount 1 ; sh:class sh:NodeShape ],
        [ sh:path :usesSupportProfile ; sh:maxCount 1 ; sh:class view:PresentationSupportProfile ],
        [ sh:path :opensPresentationClass ; sh:maxCount 1 ; sh:class owl:Class ],
        [ sh:path :defaultClosed ; sh:datatype xsd:boolean ; sh:maxCount 1 ],
        [ sh:path :expandable ; sh:datatype xsd:boolean ; sh:maxCount 1 ] .
