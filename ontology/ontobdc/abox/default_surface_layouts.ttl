@prefix view: <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#> .
@prefix default: <urn:ontobdc:view:default-surface-layout:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .

# Shipped fallback `view:DefaultSurfaceLayout` — used whenever a container
# configures no `view.surfaceLayoutsPath` of its own (see claude2.md and
# ontobdc's `SurfaceOperationalMatchedCapability`). No availableColumns/
# availableRows bounds are declared, so it always matches regardless of
# measured capacity: a project that wants tiered (compact/regular/wide)
# behavior instead supplies its own layouts file, which replaces this one
# entirely rather than merging with it.
default:standard
    a view:DefaultSurfaceLayout ;
    view:layoutPriority 0 ;
    view:hasRegion default:operation ;
    view:hasRegion default:content ;
    view:hasRegion default:pinned .

default:operation
    a view:OperationRegion ;
    view:scrollable false ;
    view:hasComponentPlacement default:OntoBDCLogoPlacement ;
    view:hasComponentPlacement default:languagePlacement ;
    view:hasComponentPlacement default:themePlacement .

default:content
    a view:ContentRegion ;
    view:scrollable true .

default:pinned
    a view:PinnedRegion ;
    view:scrollable false .

default:OntoBDCLogo a view:LogoTile .
default:theme a view:ThemeTile .
default:language a view:LanguageTile .

default:OntoBDCLogoPlacement
    a view:ComponentPlacement ;
    view:placesComponent default:OntoBDCLogo ;
    view:hasAlignment view:StartAlignment ;
    view:placementOrder 10 .

default:languagePlacement
    a view:ComponentPlacement ;
    view:placesComponent default:language ;
    view:hasAlignment view:EndAlignment ;
    view:placementOrder 10 .

default:themePlacement
    a view:ComponentPlacement ;
    view:placesComponent default:theme ;
    view:hasAlignment view:EndAlignment ;
    view:placementOrder 20 .

# OntoBDC branding assets.
default:OntoBDCBrand
    a owl:NamedIndividual, schema:Brand, schema:ImageObject ;
    schema:name "OntoBDC" ;
    prov:atLocation ".__ontobdc__/asset/OntoBDCBrand.svg" ;
    schema:encodingFormat "image/svg+xml" ;
    schema:logo default:OntoBDCLogotype ;
    schema:slogan default:OntoBDCSlogan .

default:OntoBDCLogotype
    a owl:NamedIndividual, schema:ImageObject ;
    prov:atLocation ".__ontobdc__/asset/OntoBDCLogotype.svg" ;
    schema:encodingFormat "image/svg+xml" .

default:OntoBDCSlogan
    a owl:NamedIndividual, schema:TextObject ;
    prov:atLocation ".__ontobdc__/asset/OntoBDCSlogan.txt" ;
    schema:encodingFormat "text/plain" ;
    schema:text "Data with Brains"@en ;
    schema:inLanguage "en" .
