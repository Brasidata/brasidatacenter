@base <http://datacenter.app.br/ontology/social/entity/vector.ttl#> .

<http://datacenter.app.br/ontology/social/entity/vector.ttl> rdf:type owl:Ontology ;
    owl:imports <http://ontobdc.org/ontology/domain/ontobdc/ns.ttl> ,
                <http://datacenter.app.br/ontology/social/entity/document/type.ttl> .

#################################################################
#    Annotation properties
#################################################################

###  https://schema.org/description
schema:description rdf:type owl:AnnotationProperty .


###  https://schema.org/identifier
schema:identifier rdf:type owl:AnnotationProperty .


###  https://schema.org/name
schema:name rdf:type owl:AnnotationProperty .


#################################################################
#    Data properties
#################################################################

###  http://datacenter.app.br/ontology/social/entity/vector.ttl#contentLanguage
:contentLanguage rdf:type owl:DatatypeProperty .


###  http://datacenter.app.br/ontology/social/entity/vector.ttl#languageScore
:languageScore rdf:type owl:DatatypeProperty .


###  http://datacenter.app.br/ontology/social/entity/vector.ttl#learnedAt
:learnedAt rdf:type owl:DatatypeProperty .


