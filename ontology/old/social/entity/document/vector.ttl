#################################################################
#    Individuals
#################################################################

###  http://datacenter.app.br/ontology/social/entity/vector.ttl#LinkedInJobOffer
:LinkedInJobOffer rdf:type owl:NamedIndividual ,
        obdc:DocumentType ;
    schema:description "LinkedIn job posting describing a target job title, role summary, employment type, work location, requirements, skill groups, and achievements expected for a position."@en ;
    schema:identifier "linkedin_job_offer" ;
    schema:name "LinkedIn Job Offer"@en ;
    obdc:isDocumentEntityTypeOf type:JobOffer ;
    obdc:documentTypeVectorValue "[0.06, 0.54, 0.18, 0.0453]" ;
    :contentLanguage "en" ;
    :languageScore -14156.663292884827 ;
    :learnedAt "2026-07-22T20:23:18+00:00"^^xsd:dateTime ;
    :supportedFileType "application/pdf" .
