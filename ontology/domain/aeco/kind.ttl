# AECO kinds: one declaration per concept, ordered alphabetically.
# Alternate labels include canonical forms used by kind resolution.
# Existing concept URIs, relationships and language tags are preserved.

@prefix : <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


# Ontology declarations
# ---------------------------------------------------------------

<http://datacenter.app.br/ontology/domain/aeco/ns.ttl>
    rdf:type owl:Ontology ;
    rdfs:label "AECO Ontology"@en,
        "Ontologia do setor AECO"@pt-br .

<http://datacenter.app.br/ontology/domain/aeco/sanitary.ttl>
    rdf:type owl:Ontology .


# Annotation properties
# ---------------------------------------------------------------

dcterms:identifier
    rdf:type owl:AnnotationProperty .

skos:altLabel
    rdf:type owl:AnnotationProperty .

skos:definition
    rdf:type owl:AnnotationProperty .

skos:prefLabel
    rdf:type owl:AnnotationProperty .


