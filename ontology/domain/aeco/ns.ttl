@prefix : <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix omg: <https://w3id.org/omg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .

<http://datacenter.app.br/ontology/domain/aeco/ns.ttl> rdf:type owl:Ontology ;
                                                        rdfs:label "AECO Ontology"@en ,
                                                                   "Ontologia do setor AECO"@pt-br .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Visual representations
#################################################################

:VisualRepresentation rdf:type owl:Class ;
    rdfs:subClassOf crm:E36_Visual_Item ;
    rdfs:label "Visual representation"@en ,
               "Representação visual"@pt-br .

:isVisualRepresentationOf rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P138_represents ;
    rdfs:label "is visual representation of"@en ,
               "é representação visual de"@pt-br .

:hasVisualRepresentation rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf crm:P138i_has_representation ;
    rdfs:label "has visual representation"@en ,
               "tem representação visual"@pt-br .


#################################################################
#    3D representations
#################################################################

:ModelElement3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf omg:Geometry ;
    rdfs:label "Model element 3D representation"@en ,
               "Representação 3D de elemento do modelo"@pt-br .

:SolidPrimitive3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :ModelElement3DRepresentation ;
    rdfs:label "Solid primitive 3D representation"@en ,
               "Representação 3D por primitiva sólida"@pt-br .


#################################################################
#    Primitive geometries
#################################################################

:Box3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :SolidPrimitive3DRepresentation ;
    rdfs:label "Box geometry"@en ,
               "Geometria de caixa"@pt-br ;
    skos:definition "Rectangular box delimited by six rectangular faces."@en ,
                    "Paralelepípedo retangular delimitado por seis faces retangulares."@pt-br .

:Spherical3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :SolidPrimitive3DRepresentation ;
    rdfs:label "Spherical geometry"@en ,
               "Geometria esférica"@pt-br ;
    skos:definition "Sphere defined by its center and radius."@en ,
                    "Esfera definida pelo centro e pelo raio."@pt-br .

:Cylindrical3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :SolidPrimitive3DRepresentation ;
    rdfs:label "Cylindrical geometry"@en ,
               "Geometria cilíndrica"@pt-br ;
    skos:definition "Right circular cylinder defined by its radius and height."@en ,
                    "Cilindro circular reto definido pelo raio e pela altura."@pt-br .


#################################################################
#    Solid and hollow variants
#################################################################

:SolidBox3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :Box3DRepresentation ;
    rdfs:label "Solid box"@en ,
               "Caixa maciça"@pt-br ;
    skos:definition "Box whose whole volume is filled with material."@en ,
                    "Caixa cujo volume é inteiramente preenchido por material."@pt-br .

:HollowBox3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :Box3DRepresentation ;
    rdfs:label "Hollow box"@en ,
               "Caixa oca"@pt-br ;
    skos:definition "Box whose material is limited to a boundary wall of given thickness around an empty interior."@en ,
                    "Caixa cujo material se limita a uma parede de fronteira com espessura, em torno de um interior vazio."@pt-br .

:SolidSpherical3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :Spherical3DRepresentation ;
    rdfs:label "Solid sphere"@en ,
               "Esfera maciça"@pt-br ;
    skos:definition "Sphere whose whole volume is filled with material."@en ,
                    "Esfera cujo volume é inteiramente preenchido por material."@pt-br .

:HollowSpherical3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :Spherical3DRepresentation ;
    rdfs:label "Hollow sphere"@en ,
               "Esfera oca"@pt-br ;
    skos:definition "Sphere whose material is limited to a boundary wall of given thickness around an empty interior."@en ,
                    "Esfera cujo material se limita a uma parede de fronteira com espessura, em torno de um interior vazio."@pt-br .

:SolidCylindrical3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :Cylindrical3DRepresentation ;
    rdfs:label "Solid cylinder"@en ,
               "Cilindro maciço"@pt-br ;
    skos:definition "Cylinder whose whole volume is filled with material."@en ,
                    "Cilindro cujo volume é inteiramente preenchido por material."@pt-br .

:HollowCylindrical3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf :Cylindrical3DRepresentation ;
    rdfs:label "Hollow cylinder"@en ,
               "Cilindro oco"@pt-br ;
    skos:definition "Cylinder whose material is limited to a boundary wall of given thickness around an empty interior, as in a pipe."@en ,
                    "Cilindro cujo material se limita a uma parede de fronteira com espessura, em torno de um interior vazio, como em um tubo."@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#ComodoContiguo
:ComodoContiguo rdf:type owl:Class ;
                dcterms:identifier "ComodoContiguo" ;
                skos:altLabel "ambiente contíguo"@pt-br ;
                skos:definition "Cômodo situado imediatamente junto a outro, compartilhando com ele uma divisa física, normalmente uma parede, sem que seja necessária a existência de porta ou passagem direta entre ambos."@pt-br ,
                                "A room immediately adjacent to another, sharing a physical boundary with it, typically a wall, without requiring a direct doorway or passage between them."@en ;
                skos:prefLabel "Adjacent room"@en ,
                               "Cômodo contíguo"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#NovoComodo
:NovoComodo rdf:type owl:Class ;
            dcterms:identifier "NovoComodo" ;
            skos:definition "Cômodo criado por construção, ampliação ou reconfiguração de uma edificação existente."@pt-br ;
            skos:prefLabel "Novo cômodo"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#NovoComodoContiguo
:NovoComodoContiguo rdf:type owl:Class ;
                    rdfs:subClassOf :ComodoContiguo ,
                                    :NovoComodo ;
                    dcterms:identifier "NovoComodoContiguo" ;
                    skos:definition "Novo cômodo situado imediatamente junto a outro, compartilhando com ele uma divisa física, normalmente uma parede."@pt-br ;
                    skos:prefLabel "Novo cômodo contíguo"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#PocoDeVentilacao
:PocoDeVentilacao rdf:type owl:Class ;
                  dcterms:identifier "PocoDeVentilacao" ;
                  skos:definition "Espaço vertical ou vazio construtivo destinado a promover a ventilação natural de ambientes internos e a renovação do ar."@pt-br ;
                  skos:prefLabel "Poço de ventilação"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#RecomposicaoEstrutural
:RecomposicaoEstrutural rdf:type owl:Class ;
                        dcterms:identifier "RecomposicaoEstrutural" ;
                        skos:definition "Intervenção destinada a restabelecer a integridade, a geometria ou a capacidade resistente de um elemento ou sistema estrutural afetado por dano, deterioração, remoção ou alteração."@pt-br ;
                        skos:prefLabel "Recomposição estrutural"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#RecomposicaoEstruturalComodo
:RecomposicaoEstruturalComodo rdf:type owl:Class ;
                              rdfs:subClassOf :RecomposicaoEstrutural ;
                              dcterms:identifier "RecomposicaoEstruturalComodo" ;
                              skos:definition "Intervenção de recomposição estrutural executada em elementos que compõem ou delimitam um cômodo."@pt-br ;
                              skos:prefLabel "Recomposição estrutural cômodo"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#AdequacaoDeComodo
:AdequacaoDeComodo rdf:type owl:Class ;
                   dcterms:identifier "AdequacaoDeComodo" ;
                   skos:definition "Intervenção que modifica um cômodo existente para atender novos requisitos de uso, desempenho, acessibilidade, instalações, segurança ou conformidade."@pt-br ;
                   skos:prefLabel "Adequação de cômodo"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#AmpliacaoEAdequacao
:AmpliacaoEAdequacao rdf:type owl:Class ;
                     dcterms:identifier "AmpliacaoEAdequacao" ;
                     skos:definition "Intervenção que combina aumento de área, capacidade ou extensão com a adequação de uma construção ou parte dela."@pt-br ;
                     skos:prefLabel "Ampliação e adequação"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#AmpliacaoEAdequacaoDeComodo
:AmpliacaoEAdequacaoDeComodo rdf:type owl:Class ;
                             rdfs:subClassOf :AmpliacaoEAdequacao ;
                             dcterms:identifier "AmpliacaoEAdequacaoDeComodo" ;
                             skos:definition "Intervenção que combina a ampliação de um cômodo com sua adequação a novos requisitos de uso ou desempenho."@pt-br ;
                             skos:prefLabel "Ampliação e adequação de cômodo"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#ConstrucaoAmpliacaoEAdequacao
:ConstrucaoAmpliacaoEAdequacao rdf:type owl:Class ;
                               dcterms:identifier "ConstrucaoAmpliacaoEAdequacao" ;
                               skos:definition "Intervenção que reúne atividades de construção, ampliação e adequação em uma edificação ou parte dela."@pt-br ;
                               skos:prefLabel "Construção ampliação e adequação"@pt-br .

###  http://datacenter.app.br/ontology/domain/aeco/ns.ttl#ConstrucaoAmpliacaoEAdequacaoDeComodo
:ConstrucaoAmpliacaoEAdequacaoDeComodo rdf:type owl:Class ;
                                       rdfs:subClassOf :ConstrucaoAmpliacaoEAdequacao ;
                                       dcterms:identifier "ConstrucaoAmpliacaoEAdequacaoDeComodo" ;
                                       skos:definition "Intervenção aplicada a um cômodo que reúne atividades de construção, ampliação e adequação."@pt-br ;
                                       skos:prefLabel "Construção ampliação e adequação de cômodo"@pt-br .

