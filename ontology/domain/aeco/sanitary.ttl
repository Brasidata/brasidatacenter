@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://datacenter.app.br/ontology/domain/aeco/sanitary.ttl>
    rdf:type owl:Ontology .

aeco:Chuveiro rdf:type owl:Class ;
    owl:equivalentClass aeco:Shower ;
    dcterms:identifier "Chuveiro" ;
    skos:prefLabel "Chuveiro"@pt-br ,
        "Shower"@en .

aeco:Shower rdf:type owl:Class ;
    owl:equivalentClass aeco:Chuveiro ;
    dcterms:identifier "Shower" ;
    skos:prefLabel "Shower"@en .

aeco:PiaDeCozinha rdf:type owl:Class ;
    rdfs:subClassOf aeco:Pia ;
    owl:equivalentClass aeco:KitchenSink ;
    dcterms:identifier "PiaDeCozinha" ;
    skos:prefLabel "Pia de cozinha"@pt-br ,
        "Kitchen sink"@en .

aeco:KitchenSink rdf:type owl:Class ;
    rdfs:subClassOf aeco:Sink ;
    owl:equivalentClass aeco:PiaDeCozinha ;
    dcterms:identifier "KitchenSink" ;
    skos:prefLabel "Kitchen sink"@en .

aeco:RaloSeco rdf:type owl:Class ;
    rdfs:subClassOf aeco:Ralo ;
    owl:equivalentClass aeco:FloorWaste ;
    dcterms:identifier "RaloSeco" ;
    skos:prefLabel "Ralo seco"@pt-br ,
        "Floor waste"@en .

aeco:FloorWaste rdf:type owl:Class ;
    rdfs:subClassOf aeco:Drain ;
    owl:equivalentClass aeco:RaloSeco ;
    dcterms:identifier "FloorWaste" ;
    skos:prefLabel "Floor waste"@en .

aeco:RaloSifonado rdf:type owl:Class ;
    rdfs:subClassOf aeco:Ralo ;
    owl:equivalentClass aeco:FloorTrap ;
    dcterms:identifier "RaloSifonado" ;
    skos:prefLabel "Ralo sifonado"@pt-br ,
        "Floor trap"@en .

aeco:FloorTrap rdf:type owl:Class ;
    rdfs:subClassOf aeco:Drain ;
    owl:equivalentClass aeco:RaloSifonado ;
    dcterms:identifier "FloorTrap" ;
    skos:prefLabel "Floor trap"@en .
