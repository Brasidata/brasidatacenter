@prefix : <http://datacenter.app.br/ontology/domain/aeco/representation/encoding.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/core/schema.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/domain/aeco/representation/encoding.ttl>
    rdf:type owl:Ontology ;
    rdfs:label "AECO File Encodings"@en ,
        "Codificações de Arquivo do AECO"@pt-br ;
    owl:imports <http://datacenter.app.br/ontology/domain/aeco/core/schema.ttl> .


# File encodings
# Each individual is an aeco:FileEncoding: the file extension that identifies
# it and the media type recorded for its files (e.g. RO-Crate encodingFormat).
# -----------------------------------------------------------------------------

:IfcStepEncoding rdf:type owl:NamedIndividual ,
        aeco:FileEncoding ;
    rdfs:label "IFC (STEP physical file)"@en ,
        "IFC (arquivo físico STEP)"@pt-br ;
    skos:definition "Industry Foundation Classes model serialized as an ISO 10303-21 (STEP) physical file."@en ,
        "Modelo Industry Foundation Classes serializado como arquivo físico ISO 10303-21 (STEP)."@pt-br ;
    aeco:fileExtension "ifc" ;
    aeco:mediaType "application/x-step" .

:DxfEncoding rdf:type owl:NamedIndividual ,
        aeco:FileEncoding ;
    rdfs:label "DXF (Drawing Exchange Format)"@en ,
        "DXF (Drawing Exchange Format)"@pt-br ;
    skos:definition "Two-dimensional or three-dimensional drawing in the Drawing Exchange Format."@en ,
        "Desenho bidimensional ou tridimensional no formato Drawing Exchange Format."@pt-br ;
    aeco:fileExtension "dxf" ;
    aeco:mediaType "image/vnd.dxf" .
