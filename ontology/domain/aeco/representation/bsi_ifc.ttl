                [
                    rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcCovering ;
            owl:hasValue ifc4owl:FLOORING
        ] .

# TacoDeMadeira — Piso de pequenas peças de madeira.
# -----------------------------------------------------------------------------



:WoodCeilingIfcBinding rdf:type owl:Class ;
    rdfs:subClassOf aeco:IfcElementBinding ,
        ifc4owl:IfcCovering ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:bindsIfcElementFor ;
            owl:hasValue kind:ForroDeMadeira
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:xLength ;
            owl:hasValue "0.80"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:yLength ;
            owl:hasValue "0.05"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:zLength ;
            owl:hasValue "2.10"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:hasMaterialAssociations ;
            owl:someValuesFrom [
                rdf:type ifc4owl:IfcRelAssociatesMaterial ;
                ifc4owl:relatingMaterial_IfcRelAssociatesMaterial [
                    rdf:type ifc4owl:IfcMaterial ;
                    ifc4owl:name_IfcMaterial "Madeira"@pt-br,
                        "Wood"@en
                ]
            ]
                ] ,
                [
                    rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcCovering ;
            owl:hasValue ifc4owl:CEILING
        ] .

