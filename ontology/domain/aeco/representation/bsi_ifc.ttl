@prefix kind: <http://datacenter.app.br/ontology/domain/aeco/taxonomy/kind.ttl#> .
@prefix : <http://datacenter.app.br/ontology/domain/aeco/representation/bsi_ifc.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/core/schema.ttl#> .
@prefix ifc4owl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/domain/aeco/representation/bsi_ifc.ttl>
    rdf:type owl:Ontology ;
    rdfs:label "AECO IFC4 Element Bindings"@en ,
        "Vinculações IFC4 do AECO"@pt-br .

# Ralo Sifonado (Floor Trap)
# -----------------------------------------------------------------------------


:AcrylicRoofTileIfcBinding rdf:type owl:Class ;
    rdfs:subClassOf aeco:IfcElementBinding ,
        ifc4owl:IfcCovering ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:bindsIfcElementFor ;
            owl:hasValue kind:TelhaDeAcrilico
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcCovering ;
            owl:hasValue ifc4owl:ROOFING
        ] .

