        ] .

:VigaDeConcretoRepresentation rdf:type owl:Class ;
    rdfs:subClassOf aeco:IFCRepresentation ,
        ifc4owl:IfcBeam ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:isVisualRepresentationOf ;
            owl:someValuesFrom kind:VigaDeConcreto
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcBeam ;
            owl:hasValue ifc4owl:BEAM
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty omg:hasGeometry ;
            owl:someValuesFrom aeco:SolidBox3DRepresentation
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:xLength ;
            owl:hasValue "3.00"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:yLength ;
            owl:hasValue "0.20"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:zLength ;
            owl:hasValue "0.40"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:hasMaterialAssociations ;
            owl:someValuesFrom [
                rdf:type ifc4owl:IfcRelAssociatesMaterial ;
                ifc4owl:relatingMaterial_IfcRelAssociatesMaterial [
                    rdf:type ifc4owl:IfcMaterial ;
                    ifc4owl:name_IfcMaterial "Concreto"@pt-br,
                        "Concrete"@en
                ]
            ]
        ] .

