    rdfs:subClassOf aeco:VisualRepresentation ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:isVisualRepresentationOf ;
            owl:someValuesFrom kind:Janela
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty omg:hasGeometry ;
            owl:someValuesFrom aeco:SolidBox3DRepresentation
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:xLength ;
            owl:hasValue "1.20"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:yLength ;
            owl:hasValue "0.05"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:zLength ;
            owl:hasValue "1.20"^^xsd:double
        ] .

:WindowIfcBinding rdf:type owl:Class ;
    rdfs:subClassOf aeco:IfcElementBinding ,
        ifc4owl:IfcWindow ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:bindsIfcElementFor ;
            owl:hasValue kind:Janela
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcWindow ;
            owl:hasValue ifc4owl:WINDOW
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:hasMaterialAssociations ;
            owl:someValuesFrom [
                rdf:type ifc4owl:IfcRelAssociatesMaterial ;
                ifc4owl:relatingMaterial_IfcRelAssociatesMaterial [
                    rdf:type ifc4owl:IfcMaterial ;
                    ifc4owl:name_IfcMaterial "Vidro"@pt-br,
                        "Glass"@en
                ]
            ]
        ] .


