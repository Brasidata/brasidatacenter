# Rodape — Elemento situado na junção das paredes com o piso, destinado à proteção da parede e ao acabamento.
# -----------------------------------------------------------------------------


:CorniceMouldingVisual rdf:type owl:Class ;
    rdfs:subClassOf aeco:VisualRepresentation ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:isVisualRepresentationOf ;
            owl:someValuesFrom kind:Cornija
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty omg:hasGeometry ;
            owl:someValuesFrom aeco:SolidBox3DRepresentation
        ] .

:CorniceMouldingIfcBinding rdf:type owl:Class ;
    rdfs:subClassOf aeco:IfcElementBinding ,
        ifc4owl:IfcCovering ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:bindsIfcElementFor ;
            owl:hasValue kind:Cornija
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcCovering ;
            owl:hasValue ifc4owl:MOLDING
        ] .

