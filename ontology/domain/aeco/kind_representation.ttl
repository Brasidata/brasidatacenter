@prefix kind: <http://datacenter.app.br/ontology/domain/aeco/kind.ttl#> .
@prefix : <http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix ifc4owl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix omg: <https://w3id.org/omg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl>
    rdf:type owl:Ontology .


:ConcreteBeam3DRepresentation rdf:type owl:Class ;
    rdfs:subClassOf aeco:ModelElement3DRepresentation ,
        omg:Geometry .

:ConcreteBeamRepresentation rdf:type owl:Class ;
    rdfs:subClassOf crm:E36_Visual_Item ,
        ifc4owl:IfcBeam ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty crm:P138_represents ;
            owl:someValuesFrom aeco:VigaDeConcreto
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcBeam ;
            owl:hasValue ifc4owl:BEAM
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty omg:hasGeometry ;
            owl:someValuesFrom :ConcreteBeam3DRepresentation
        ] .

aeco:VigaDeConcreto rdfs:subClassOf
    [
        rdf:type owl:Restriction ;
        owl:onProperty crm:P138i_has_representation ;
        owl:someValuesFrom :ConcreteBeamRepresentation
    ] .
