@prefix kind: <http://datacenter.app.br/ontology/domain/aeco/kind.ttl#> .
@prefix : <http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix ifc4owl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix omg: <https://w3id.org/omg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl>
    rdf:type owl:Ontology .


# Kind representations
# Primitive dimensions below are default/suggested values expressed in metres.
# -----------------------------------------------------------------------------

:FloorTrapRepresentation rdf:type owl:Class ;
    rdfs:subClassOf aeco:IFCRepresentation ,
        ifc4owl:IfcWasteTerminal ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:isVisualRepresentationOf ;
            owl:someValuesFrom kind:RaloSifonado
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcWasteTerminal ;
            owl:hasValue ifc4owl:FLOORTRAP
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty omg:hasGeometry ;
            owl:someValuesFrom aeco:SolidBox3DRepresentation
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:xLength ;
            owl:hasValue "0.15"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:yLength ;
            owl:hasValue "0.15"^^xsd:double
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:zLength ;
            owl:hasValue "0.10"^^xsd:double
        ] .

