@prefix kind: <http://datacenter.app.br/ontology/domain/aeco/kind.ttl#> .
@prefix : <http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix ifc4owl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix omg: <https://w3id.org/omg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl>
    rdf:type owl:Ontology .


# Kind representations
# -----------------------------------------------------------------------------
#
# Each kind has two parallel and independent declarations:
#   1. VISUAL side  (suffix ...Visual) — subClassOf aeco:VisualRepresentation (crm:E36_Visual_Item)
#      linked via aeco:isVisualRepresentationOf (subPropertyOf crm:P138_represents).
#      Restricted here to geometry / visual aspects only.
#   2. SEMANTIC side (suffix ...IfcBinding) — subClassOf aeco:IfcElementBinding (dul:Description)
#      linked via aeco:bindsIfcElementFor (owl:inverseOf aeco:hasIfcElementBinding).
#      Carries the non-visual engineering mapping: IFC element class, predefined type,
#      material associations, quantity take-off rules and composition relations.


# Ralo Sifonado (Floor Trap)
# -----------------------------------------------------------------------------

:FloorTrapVisual rdf:type owl:Class ;
    rdfs:subClassOf aeco:VisualRepresentation ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:isVisualRepresentationOf ;
            owl:someValuesFrom kind:RaloSifonado
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty omg:hasGeometry ;
            owl:someValuesFrom aeco:SolidBox3DRepresentation
        ] .

:FloorTrapIfcBinding rdf:type owl:Class ;
    rdfs:subClassOf aeco:IfcElementBinding ,
        ifc4owl:IfcWasteTerminal ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty aeco:bindsIfcElementFor ;
            owl:hasValue kind:RaloSifonado
        ] ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifc4owl:predefinedType_IfcWasteTerminal ;
            owl:hasValue ifc4owl:FLOORTRAP
        ] .


