@prefix : <http://datacenter.app.br/ontology/domain/productivity/taxonomy/facade.ttl#> .
@prefix facade: <http://datacenter.app.br/ontology/tool/ontobdc/facade/ns.ttl#> .
@prefix obdc: <http://datacenter.app.br/ontology/tool/ontobdc/core/ns.ttl#> .
@prefix socialfacade: <http://datacenter.app.br/ontology/domain/social/taxonomy/facade.ttl#> .
@prefix productivity: <http://datacenter.app.br/ontology/domain/productivity/taxonomy/type.ttl#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/domain/productivity/taxonomy/facade.ttl>
    rdf:type owl:Ontology ;
    schema:name "Productivity Facade"@en ,
        "Fachada de Produtividade"@pt-br ,
        "Fachada de productividad"@es ;
    schema:description "The public fields of a task, a milestone and a goal, one row of each data source: each is the column a person reads and the property it is written to."@en ,
        "Os campos públicos de uma tarefa, de um marco e de um objetivo, uma linha de cada fonte de dados: cada um é a coluna que uma pessoa lê e a propriedade em que é gravado."@pt-br ,
        "Los campos públicos de una tarea, de un hito y de un objetivo, una fila de cada fuente de datos: cada uno es la columna que una persona lee y la propiedad en la que se escribe."@es .

#################################################################
# Facades
#################################################################

:TaskFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    facade:isCommentable true ;
    schema:identifier "task" ;
    schema:name "Task"@en ,
        "Tarefa"@pt-br ,
        "Tarea"@es ;
    facade:isFacadeOf productivity:Task ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :RelatedDocumentsField ,
        :DependsOnField ,
        :PlannedStartField ,
        :PlannedFinishField ,
        :ActualStartField ,
        :ActualFinishField ,
        :CompletionPercentField ,
        socialfacade:TagsField .

:StepFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    schema:identifier "step" ;
    schema:name "Step"@en ,
        "Etapa"@pt-br ,
        "Etapa"@es ;
    facade:isFacadeOf productivity:Step ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :RelatedDocumentsField .

:MilestoneFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    facade:isCommentable true ;
    schema:identifier "milestone" ;
    schema:name "Milestone"@en ,
        "Marco"@pt-br ,
        "Hito"@es ;
    facade:isFacadeOf productivity:Milestone ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        socialfacade:TagsField .

:GoalFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    facade:isCommentable true ;
    schema:identifier "goal" ;
    schema:name "Goal"@en ,
        "Objetivo"@pt-br ,
        "Objetivo"@es ;
    facade:isFacadeOf productivity:Goal ;
    facade:hasTreeViewChild [
        rdf:type facade:TreeViewChild ;
        facade:childFacade :PlanFacade ;
        facade:childPath productivity:hasPlan
    ] ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :RelatedDocumentsField ,
        socialfacade:TagsField .

:PlanFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    schema:identifier "plan" ;
    schema:name "Plan"@en ,
        "Plano"@pt-br ,
        "Plan"@es ;
    facade:isFacadeOf productivity:Plan ;
    facade:hasTreeViewChild [
        rdf:type facade:TreeViewChild ;
        facade:childFacade :StepFacade ;
        facade:childPath productivity:hasStep
    ] ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :RelatedDocumentsField .

:TaskConstraintFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    schema:identifier "task_constraint" ;
    schema:name "Task constraint"@en ,
        "Restrição de tarefa"@pt-br ,
        "Restricción de tarea"@es ;
    facade:isFacadeOf productivity:TaskConstraint ;
    facade:hasFacadeField
        :GlobalIdField ,
        :ConstraintTypeField ,
        :PredecessorTaskField .

#################################################################
# Fields
#################################################################

:GlobalIdField
    rdf:type facade:FacadeField ;
    schema:identifier "global_id" ;
    schema:name "Global ID"@en ,
        "Identificador global"@pt-br ,
        "Identificador global"@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 0 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:hasDefault facade:UuidGenerator ;
    facade:mapsToResource dcterms:identifier .

:TitleField
    rdf:type facade:FacadeField ;
    schema:identifier "title" ;
    schema:name "Title"@en ,
        "Título"@pt-br ,
        "Título"@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 1 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource dcterms:title .

:DescriptionField
    rdf:type facade:FacadeField ;
    schema:identifier "description" ;
    schema:name "Description"@en ,
        "Descrição"@pt-br ,
        "Descripción"@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 2 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource dcterms:description .

:CreatedAtField
    rdf:type facade:FacadeField ;
    schema:identifier "created_at" ;
    schema:name "Created at"@en ,
        "Criada em"@pt-br ,
        "Creada el"@es ;
    facade:fieldDatatype xsd:dateTime ;
    csvw:format "M/d/yyyy h:mm a"@en ,
        "dd/MM/yyyy HH:mm"@pt-br ,
        "d/M/yyyy H:mm"@es ;
    facade:fieldOrder 3 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:hasDefault facade:CurrentDateTimeGenerator ;
    facade:mapsToResource dcterms:created .

:RelatedDocumentsField
    rdf:type facade:FacadeField ;
    schema:identifier "related_documents" ;
    schema:name "Related documents"@en ,
        "Documentos relacionados"@pt-br ,
        "Documentos relacionados"@es ;
    schema:description "The IRIs, in the container graph, of the documents the task or goal refers to, separated by a vertical bar."@en ,
        "Os IRIs, no grafo do container, dos documentos a que a tarefa ou o objetivo se refere, separados por uma barra vertical."@pt-br ,
        "Los IRI, en el grafo del contenedor, de los documentos a los que se refiere la tarea o el objetivo, separados por una barra vertical."@es ;
    facade:fieldDatatype xsd:anyURI ;
    facade:fieldOrder 4 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource dcterms:relation ;
    facade:hasResourceFacade :RelatedDocumentFacade ;
    facade:hasAlternativeVisualization facade:ImageCarousel .

:ConstraintTypeField
    rdf:type facade:FacadeField ;
    schema:identifier "constraint_type" ;
    schema:name "Type"@en ,
        "Tipo"@pt-br ,
        "Tipo"@es ;
    schema:description "The identifier of the constraint type (dcterms:identifier of a subclass of TaskConstraint), such as finish_to_start_task_constraint."@en ,
        "O identificador do tipo de restrição (dcterms:identifier de uma subclasse de TaskConstraint), como finish_to_start_task_constraint."@pt-br ,
        "El identificador del tipo de restricción (dcterms:identifier de una subclase de TaskConstraint), como finish_to_start_task_constraint."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 1 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:hasValuesFromSubclassesOf productivity:TaskConstraint ;
    facade:mapsToResource rdf:type .

:PredecessorTaskField
    rdf:type facade:FacadeField ;
    schema:identifier "predecessor_task" ;
    schema:name "Predecessor task"@en ,
        "Tarefa predecessora"@pt-br ,
        "Tarea predecesora"@es ;
    schema:description "The IRI, in the container graph, of the task the dependent task depends on."@en ,
        "O IRI, no grafo do container, da tarefa de que a tarefa dependente depende."@pt-br ,
        "El IRI, en el grafo del contenedor, de la tarea de la que depende la tarea dependiente."@es ;
    facade:fieldDatatype xsd:anyURI ;
    facade:fieldOrder 2 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:predecessorTask ;
    facade:hasResourceFacade :PredecessorTaskReferenceFacade .

:DependsOnField
    rdf:type facade:FacadeField ;
    schema:identifier "depends_on" ;
    schema:name "Depends on"@en ,
        "Depende de"@pt-br ,
        "Depende de"@es ;
    schema:description "The IRIs, in the container graph, of the task constraints that define what this task depends on, separated by a vertical bar. The type of each constraint and its predecessor task are stated by the constraint, not by this field."@en ,
        "Os IRIs, no grafo do container, das restrições de tarefa que definem de que esta tarefa depende, separados por uma barra vertical. O tipo de cada restrição e sua tarefa predecessora são ditos pela restrição, e não por este campo."@pt-br ,
        "Los IRI, en el grafo del contenedor, de las restricciones de tarea que definen de qué depende esta tarea, separados por una barra vertical. El tipo de cada restricción y su tarea predecesora los indica la restricción, no este campo."@es ;
    facade:fieldDatatype xsd:anyURI ;
    facade:fieldOrder 5 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:dependsOn ;
    facade:hasResourceFacade :TaskConstraintReferenceFacade .

:TaskConstraintReferenceFacade
    rdf:type facade:ResourceFacade ;
    facade:isFacadeOf productivity:TaskConstraint ;
    facade:hasFacadeField
        :ConstraintTypeField ,
        :PredecessorTaskField .

:PredecessorTaskReferenceFacade
    rdf:type facade:ResourceFacade ;
    facade:isFacadeOf productivity:Task ;
    facade:hasFacadeField
        :TitleField .

:RelatedDocumentFacade
    rdf:type facade:ResourceFacade ;
    facade:isFacadeOf obdc:FileDisplayProfile  ;
    facade:hasFacadeField
        :TitleField  .

:PlannedStartField
    rdf:type facade:FacadeField ;
    schema:identifier "planned_start" ;
    schema:name "Planned start"@en ,
        "Início planejado"@pt-br ,
        "Inicio planificado"@es ;
    facade:fieldDatatype xsd:date ;
    facade:fieldOrder 6 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:plannedStart .

:PlannedFinishField
    rdf:type facade:FacadeField ;
    schema:identifier "planned_finish" ;
    schema:name "Planned finish"@en ,
        "Término planejado"@pt-br ,
        "Fin planificado"@es ;
    facade:fieldDatatype xsd:date ;
    facade:fieldOrder 7 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:plannedFinish .

:ActualStartField
    rdf:type facade:FacadeField ;
    schema:identifier "actual_start" ;
    schema:name "Actual start"@en ,
        "Início real"@pt-br ,
        "Inicio real"@es ;
    facade:fieldDatatype xsd:date ;
    facade:fieldOrder 8 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:actualStart .

:ActualFinishField
    rdf:type facade:FacadeField ;
    schema:identifier "actual_finish" ;
    schema:name "Actual finish"@en ,
        "Término real"@pt-br ,
        "Fin real"@es ;
    facade:fieldDatatype xsd:date ;
    facade:fieldOrder 9 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:actualFinish .

:CompletionPercentField
    rdf:type facade:FacadeField ;
    schema:identifier "completion_percent" ;
    schema:name "Completion percentage"@en ,
        "Percentual de conclusão"@pt-br ,
        "Porcentaje de finalización"@es ;
    facade:fieldDatatype xsd:integer ;
    facade:fieldOrder 10 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:completionPercent .

:WorkStreamFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    facade:isCommentable true ;
    schema:identifier "work_stream" ;
    schema:name "Work Stream"@en ,
        "Frente de trabalho"@pt-br ,
        "Frente de trabajo"@es ;
    facade:isFacadeOf productivity:WorkStream ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :FrameworkField ,
        :RelatedDocumentsField ,
        socialfacade:TagsField .

:FiveWTwoHFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    facade:isCommentable true ;
    schema:identifier "5w2h" ;
    schema:name "5W2H"@en ,
        "5W2H"@pt-br ,
        "5W2H"@es ;
    facade:isFacadeOf productivity:FiveWTwoH ;
    facade:hasFacadeField
        :GlobalIdField ,
        :FiveWTwoHTitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :WhatField ,
        :WhatTextField ,
        :WhyField ,
        :WhyTextField ,
        :WhoField ,
        :WhoTextField ,
        :WhereField ,
        :WhereTextField ,
        :WhenField ,
        :WhenTextField ,
        :HowField ,
        :HowTextField ,
        :HowMuchField ,
        :HowMuchTextField ,
        socialfacade:TagsField .

:FiveWTwoHTitleField
    rdf:type facade:FacadeField ;
    schema:identifier "title" ;
    schema:name "Title"@en ,
        "Título"@pt-br ,
        "Título"@es ;
    schema:description "The title of the 5W2H, which is always 5W2H: it is not asked for."@en ,
        "O título do 5W2H, que é sempre 5W2H: não é perguntado."@pt-br ,
        "El título del 5W2H, que siempre es 5W2H: no se pregunta."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 1 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:isEditable false ;
    facade:hasDefaultValue "5W2H" ;
    facade:mapsToResource dcterms:title .

:WhatField
    rdf:type facade:FacadeField ;
    schema:identifier "what" ;
    schema:name "What?"@en ,
        "O que?"@pt-br ,
        "¿Qué?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer what in the 5W2H. Scope or work content associated with the work stream."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem o que no 5W2H. Escopo ou conteúdo de trabalho associado à frente de trabalho."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden qué en el 5W2H. Alcance o contenido de trabajo asociado al frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 10 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:what ;
    facade:hasResourceFacade :EntityReferenceFacade .

:WhyField
    rdf:type facade:FacadeField ;
    schema:identifier "why" ;
    schema:name "Why?"@en ,
        "Por quê?"@pt-br ,
        "¿Por qué?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer why in the 5W2H. Purpose, need or justification of the work stream."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem por que no 5W2H. Propósito, necessidade ou justificativa da frente de trabalho."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden por qué en el 5W2H. Propósito, necesidad o justificación del frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 11 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:why ;
    facade:hasResourceFacade :EntityReferenceFacade .

:WhoField
    rdf:type facade:FacadeField ;
    schema:identifier "who" ;
    schema:name "Who?"@en ,
        "Quem?"@pt-br ,
        "¿Quién?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer who in the 5W2H. Person, organization, team or role involved in the work stream."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem quem no 5W2H. Pessoa, organização, equipe ou papel envolvido na frente de trabalho."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden quién en el 5W2H. Persona, organización, equipo o rol involucrado en el frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 12 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:who ;
    facade:hasResourceFacade :EntityReferenceFacade .

:WhereField
    rdf:type facade:FacadeField ;
    schema:identifier "where" ;
    schema:name "Where?"@en ,
        "Onde?"@pt-br ,
        "¿Dónde?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer where in the 5W2H. Place, facility, building, storey or zone the work stream is about."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem onde no 5W2H. Lugar, instalação, edificação, pavimento ou zona de que trata a frente de trabalho."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden dónde en el 5W2H. Lugar, instalación, edificio, planta o zona de que trata el frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 13 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:where ;
    facade:hasResourceFacade :EntityReferenceFacade .

:WhenField
    rdf:type facade:FacadeField ;
    schema:identifier "when" ;
    schema:name "When?"@en ,
        "Quando?"@pt-br ,
        "¿Cuándo?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer when in the 5W2H. Milestone, period or schedule of the work stream."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem quando no 5W2H. Marco, período ou cronograma da frente de trabalho."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden cuándo en el 5W2H. Hito, período o cronograma del frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 14 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:when ;
    facade:hasResourceFacade :EntityReferenceFacade .

:HowField
    rdf:type facade:FacadeField ;
    schema:identifier "how" ;
    schema:name "How?"@en ,
        "Como?"@pt-br ,
        "¿Cómo?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer how in the 5W2H. Method, procedure or strategy by which the work stream is performed."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem como no 5W2H. Método, procedimento ou estratégia pela qual a frente de trabalho é executada."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden cómo en el 5W2H. Método, procedimiento o estrategia con que se ejecuta el frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 15 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:how ;
    facade:hasResourceFacade :EntityReferenceFacade .

:HowMuchField
    rdf:type facade:FacadeField ;
    schema:identifier "howMuch" ;
    schema:name "How much?"@en ,
        "Quanto?"@pt-br ,
        "¿Cuánto?"@es ;
    schema:description "The global ids, separated by a vertical bar, of the entities of the container that answer how much in the 5W2H. Cost, quantity or effort of the work stream."@en ,
        "Os identificadores globais, separados por uma barra vertical, das entidades do container que respondem quanto no 5W2H. Custo, quantidade ou esforço da frente de trabalho."@pt-br ,
        "Los identificadores globales, separados por una barra vertical, de las entidades del contenedor que responden cuánto en el 5W2H. Costo, cantidad o esfuerzo del frente de trabajo."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 16 ;
    facade:isRequired false ;
    facade:isMultivalued true ;
    facade:isEditable true ;
    facade:mapsToResource productivity:howMuch ;
    facade:hasResourceFacade :EntityReferenceFacade .

:WhatTextField
    rdf:type facade:FacadeField ;
    schema:identifier "what_text" ;
    schema:name "What needs to be done"@en ,
        "O que precisa ser feito"@pt-br ,
        "Qué debe hacerse"@es ;
    schema:description "Free-form text, including line breaks, that answers what in the 5W2H, beside the entities that also answer it. Scope or work content written out."@en ,
        "Texto livre, incluindo quebras de linha, que responde o que no 5W2H, ao lado das entidades que também respondem. Escopo ou conteúdo de trabalho escrito."@pt-br ,
        "Texto libre, incluidas las líneas nuevas, que responde qué en el 5W2H, junto a las entidades que también responden. Alcance o contenido de trabajo escrito."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 17 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:whatText .

:WhyTextField
    rdf:type facade:FacadeField ;
    schema:identifier "why_text" ;
    schema:name "Why it needs to be done"@en ,
        "Por que precisa ser feito"@pt-br ,
        "Por qué debe hacerse"@es ;
    schema:description "Free-form text, including line breaks, that answers why in the 5W2H, beside the entities that also answer it. Purpose, need or justification written out."@en ,
        "Texto livre, incluindo quebras de linha, que responde por que no 5W2H, ao lado das entidades que também respondem. Propósito, necessidade ou justificativa escrita."@pt-br ,
        "Texto libre, incluidas las líneas nuevas, que responde por qué en el 5W2H, junto a las entidades que también responden. Propósito, necesidad o justificación escrita."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 18 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource productivity:whyText .

:WhoTextField
    rdf:type facade:FacadeField ;
    schema:identifier "who_text" ;
    schema:name "Who needs to do it"@en ,
        "Quem precisa fazer"@pt-br ,
        "Quién debe hacerlo"@es ;
