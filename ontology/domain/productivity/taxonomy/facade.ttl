:FrameworkField
    rdf:type facade:FacadeField ;
    schema:identifier "framework" ;
    schema:name "Framework"@en ,
        "Framework de gerenciamento"@pt-br ,
        "Marco de gestión"@es ;
    schema:description "The global id of the project management framework the work stream is managed through, one of the frameworks of the container (a 5W2H, for instance), which holds what the framework asks."@en ,
        "O identificador global do framework de gerenciamento de projeto pelo qual a frente de trabalho é gerenciada, um dos frameworks do container (um 5W2H, por exemplo), que guarda o que o framework pede."@pt-br ,
        "El identificador global del marco de gestión de proyectos con el que se gestiona el frente de trabajo, uno de los marcos del contenedor (un 5W2H, por ejemplo), que guarda lo que pide el marco."@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 20 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource obdc:usesProjectManagementFramework ;
    facade:isOwned true ;
    facade:hasResourceFacade :ProjectManagementFrameworkReferenceFacade ;
    facade:hasAlternativeVisualization facade:FrameworkAspects .

