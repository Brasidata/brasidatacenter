@prefix : <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl#> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ns.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl#> .

<http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl>
    rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

#################################################################
#    Classes
#################################################################

:WorkStream rdf:type owl:Class ,
        obdc:SurfaceableEntity ;
    rdfs:label "Work Stream"@en ,
        "Frente de trabalho"@pt-BR ;
    rdfs:comment "Coherent scope of coordinated work within a project."@en ;
    schema:description "Project work scope that may be organized and managed through one or more project management frameworks. 5W2H is one supported framework."@en .

#################################################################
#    Object Properties
#################################################################

:what rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "what"@en ,
        "o que"@pt-BR ;
    schema:description "Scope or work content associated with the WorkStream."@en .

:why rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "why"@en ,
        "por que"@pt-BR ;
    schema:description "Purpose, need, or justification associated with the WorkStream."@en .

:who rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "who"@en ,
        "quem"@pt-BR ;
    schema:description "Person, organization, team, role, or other data entity involved in the WorkStream."@en .

:where rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "where"@en ,
        "onde"@pt-BR ;
    schema:description "Place, facility, building, storey, zone, or other spatial data entity associated with the WorkStream."@en .

:when rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "when"@en ,
        "quando"@pt-BR ;
    schema:description "Temporal context, milestone, period, schedule, or other data entity associated with the WorkStream."@en .

:how rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "how"@en ,
        "como"@pt-BR ;
    schema:description "Method, procedure, execution strategy, or other data entity describing how the WorkStream is performed."@en .

:howMuch rdf:type owl:ObjectProperty ;
    rdfs:domain :WorkStream ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "how much"@en ,
        "quanto"@pt-BR ;
    schema:description "Cost, quantity, effort, or other magnitude represented by a data entity associated with the WorkStream."@en .

#################################################################
#    Project Management Frameworks
#################################################################

:FiveWTwoH rdf:type owl:Class ;
    rdfs:subClassOf obdc:ProjectManagementFramework ;
    rdfs:label "5W2H"@en ,
        "5W2H"@pt-BR ;
    schema:identifier "5w2h" ;
    schema:description "Project management framework that structures a work scope through What, Why, Who, Where, When, How, and How Much dimensions."@en .
