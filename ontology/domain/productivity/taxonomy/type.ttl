
@prefix : <http://datacenter.app.br/ontology/domain/productivity/taxonomy/type.ttl#> .
@prefix obdc: <http://datacenter.app.br/ontology/tool/ontobdc/core/ns.ttl#> .
@prefix code: <http://datacenter.app.br/ontology/tool/ontobdc/core/code.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ilap: <http://data.posccaesar.org/ilap/> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix pko: <https://w3id.org/pko#> .
@prefix sbpmnc: <https://sBPMN.github.io/2.0/classes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/domain/productivity/taxonomy/type.ttl>
    rdf:type owl:Ontology ;
    rdfs:label "Productivity Types"@en ,
        "Tipos de Produtividade"@pt-br .

#################################################################
# Classes
#################################################################

:Task rdf:type owl:Class ;
    rdfs:subClassOf obdc:DataEntity , dul:Task ;
    dcterms:identifier "task" ;
    rdfs:label "Task"@en ,
        "Tarefa"@pt-br ;
    skos:definition
        "A type of work that can be executed by one or more actions."@en ,
        "Um tipo de trabalho que pode ser executado por uma ou mais ações."@pt-br .

:Action rdf:type owl:Class ;
    rdfs:subClassOf obdc:DataEntity , dul:Action ;
    dcterms:identifier "action" ;
    rdfs:label "Action"@en ,
        "Ação"@pt-br ;
    skos:definition
        "An event in which an agent executes one or more defined tasks."@en ,
        "Um evento no qual um agente executa uma ou mais tarefas definidas."@pt-br .

:Milestone rdf:type owl:Class ;
    rdfs:subClassOf obdc:DataEntity , time:Instant ;
    dcterms:identifier "milestone" ;
    rdfs:label "Milestone"@en ,
        "Marco"@pt-br ;
    skos:definition
        "A significant checkpoint representing an event or achievement in a work process."@en ,
        "Ponto de controle significativo que representa um evento ou uma realização em um processo de trabalho."@pt-br .

:Goal rdf:type owl:Class ;
    rdfs:subClassOf obdc:DataEntity , dul:Goal ;
    dcterms:identifier "goal" ;
    rdfs:label "Goal"@en ,
        "Objetivo"@pt-br ;
    skos:definition
        "A desired state or outcome to be achieved."@en ,
        "Estado ou resultado desejado a ser alcançado."@pt-br .

:ActivityConstraint rdf:type owl:Class ;
    rdfs:subClassOf ilap:ActivityConstraint ;
    dcterms:identifier "activity_constraint" ;
    rdfs:label "Activity constraint"@en ,
        "Restrição de atividade"@pt-br ;
    skos:definition
        "A dependency or scheduling constraint between activities."@en ,
        "Restrição de dependência ou de sequenciamento entre atividades."@pt-br .

:TaskConstraint rdf:type owl:Class ;
    rdfs:subClassOf :ActivityConstraint , obdc:DataEntity ;
    dcterms:identifier "task_constraint" ;
    rdfs:label "Task constraint"@en ,
        "Restrição de tarefa"@pt-br ;
    skos:definition
        "An activity constraint that defines a dependency between tasks."@en ,
        "Restrição de atividade que define uma dependência entre tarefas."@pt-br .

:FinishToFinishTaskConstraint rdf:type owl:Class ;
    rdfs:subClassOf :TaskConstraint , ilap:FF ;
    dcterms:identifier "finish_to_finish_task_constraint" ;
    rdfs:label "Finish-to-finish task constraint"@en ,
        "Restrição tarefa término-término"@pt-br ;
    skos:definition
        "A task dependency constraint in which the successor cannot finish before the predecessor finishes."@en ,
        "Restrição entre tarefas na qual a sucessora não pode terminar antes do término da predecessora."@pt-br .

:FinishToStartTaskConstraint rdf:type owl:Class ;
    rdfs:subClassOf :TaskConstraint , ilap:FS ;
    dcterms:identifier "finish_to_start_task_constraint" ;
    rdfs:label "Finish-to-start task constraint"@en ,
        "Restrição tarefa término-início"@pt-br ;
    skos:definition
        "A task dependency constraint in which the successor cannot start before the predecessor finishes."@en ,
        "Restrição entre tarefas na qual a sucessora não pode iniciar antes do término da predecessora."@pt-br .

:StartToFinishTaskConstraint rdf:type owl:Class ;
    rdfs:subClassOf :TaskConstraint , ilap:SF ;
    dcterms:identifier "start_to_finish_task_constraint" ;
    rdfs:label "Start-to-finish task constraint"@en ,
        "Restrição tarefa início-término"@pt-br ;
    skos:definition
        "A task dependency constraint in which the successor cannot finish before the predecessor starts."@en ,
        "Restrição entre tarefas na qual a sucessora não pode terminar antes do início da predecessora."@pt-br .

:StartToStartTaskConstraint rdf:type owl:Class ;
    rdfs:subClassOf :TaskConstraint , ilap:SS ;
    dcterms:identifier "start_to_start_task_constraint" ;
    rdfs:label "Start-to-start task constraint"@en ,
        "Restrição tarefa início-início"@pt-br ;
    skos:definition
        "A task dependency constraint in which the successor cannot start before the predecessor starts."@en ,
        "Restrição entre tarefas na qual a sucessora não pode iniciar antes do início da predecessora."@pt-br .

#################################################################
# Data Properties
#################################################################

:plannedStart rdf:type owl:DatatypeProperty ;
    rdfs:domain :Action ;
    rdfs:range xsd:date ;
    rdfs:label "Planned start"@en ,
        "Início planejado"@pt-br ,
        "Inicio planificado"@es ;
    skos:definition
        "Date on which the action is planned to start."@en ,
        "Data prevista para o início da ação."@pt-br .

:plannedFinish rdf:type owl:DatatypeProperty ;
    rdfs:domain :Action ;
    rdfs:range xsd:date ;
    rdfs:label "Planned finish"@en ,
        "Término planejado"@pt-br ,
        "Fin planificado"@es ;
    skos:definition
        "Date on which the action is planned to finish."@en ,
        "Data prevista para o término da ação."@pt-br .

:actualStart rdf:type owl:DatatypeProperty ;
    rdfs:domain :Action ;
    rdfs:range xsd:date ;
    rdfs:label "Actual start"@en ,
        "Início real"@pt-br ,
        "Inicio real"@es ;
    skos:definition
        "Date on which the action actually started."@en ,
        "Data em que a ação efetivamente começou."@pt-br .

:actualFinish rdf:type owl:DatatypeProperty ;
    rdfs:domain :Action ;
    rdfs:range xsd:date ;
    rdfs:label "Actual finish"@en ,
        "Término real"@pt-br ,
        "Fin real"@es ;
    skos:definition
        "Date on which the action actually finished."@en ,
        "Data em que a ação efetivamente terminou."@pt-br .

:completionPercent rdf:type owl:DatatypeProperty ;
    rdfs:domain :Action ;
    rdfs:range xsd:integer ;
    rdfs:label "Completion percentage"@en ,
        "Percentual de conclusão"@pt-br ,
        "Porcentaje de finalización"@es ;
    skos:definition
        "Action completion percentage, from 0 to 100."@en ,
        "Percentual de conclusão da ação, de 0 a 100."@pt-br .

:Step rdf:type owl:Class ;
    rdfs:subClassOf obdc:DataEntity , pplan:Step ;
    dcterms:identifier "step" ;
    rdfs:label "Step"@en ,
        "Etapa"@pt-br ;
    skos:definition
        "A step that makes up a plan."@en ,
        "Etapa que compõe um plano."@pt-br .

:Plan rdf:type owl:Class ;
    rdfs:subClassOf
        obdc:DataEntity ,
        pplan:Plan ;
    dcterms:identifier "plan" ;
    rdfs:label "Plan"@en ,
        "Plano"@pt-br .

#################################################################
# Procedure execution strategies
#################################################################

:ModelOfComputation rdf:type owl:Class ;
    rdfs:subClassOf pko:ProcedureType ;
    rdfs:label "Model of Computation"@en ,
        "Modelo de computação"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/doc/mainVergil.htm> ;
    owl:oneOf (
        code:FiniteStateMachine
        :SynchronousDataflow
        :DynamicDataflow
        :DiscreteEvent
        :ProcessNetworks
        :SynchronousReactive
        :ContinuousTime
        :Rendezvous
    ) .

[] rdf:type owl:AllDifferent ;
    owl:distinctMembers (
        code:FiniteStateMachine
        :SynchronousDataflow
        :DynamicDataflow
        :DiscreteEvent
        :ProcessNetworks
        :SynchronousReactive
        :ContinuousTime
        :Rendezvous
    ) .

:SynchronousDataflow rdf:type :ModelOfComputation ;
    dcterms:identifier "synchronous_dataflow" ;
    rdfs:label "Synchronous Dataflow"@en ,
        "Fluxo de dados síncrono"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/doc/codeDoc/ptolemy/domains/sdf/kernel/SDFDirector.html> ;
    skos:definition
        "A model with statically known token production and consumption rates and a statically determined schedule."@en ,
        "Modelo com taxas de produção e consumo de tokens conhecidas estaticamente e escalonamento determinado estaticamente."@pt-br .

:DynamicDataflow rdf:type :ModelOfComputation ;
    dcterms:identifier "dynamic_dataflow" ;
    rdfs:label "Dynamic Dataflow"@en ,
        "Fluxo de dados dinâmico"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/ptolemy/domains/ddf/doc/main.htm> ;
    skos:definition
        "A model in which actors fire according to data-dependent firing rules."@en ,
        "Modelo no qual os atores executam conforme regras de disparo dependentes dos dados."@pt-br .

:DiscreteEvent rdf:type :ModelOfComputation ;
    dcterms:identifier "discrete_event" ;
    rdfs:label "Discrete Event"@en ,
        "Evento discreto"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/ptolemy/domains/de/doc/main.htm> ;
    skos:definition
        "A model in which computation proceeds through events tagged with discrete points in model time."@en ,
        "Modelo no qual a computação avança por eventos associados a instantes discretos do tempo do modelo."@pt-br .

:ProcessNetworks rdf:type :ModelOfComputation ;
    dcterms:identifier "process_networks" ;
    rdfs:label "Process Networks"@en ,
        "Redes de processos"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/publications/papers/99/HMAD/html/pn.html> ;
    skos:definition
        "A model of concurrent processes communicating asynchronously through FIFO channels."@en ,
        "Modelo de processos concorrentes que se comunicam assincronamente por canais FIFO."@pt-br .

:SynchronousReactive rdf:type :ModelOfComputation ;
    dcterms:identifier "synchronous_reactive" ;
    rdfs:label "Synchronous Reactive"@en ,
        "Síncrono reativo"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/ptolemy/domains/sr/doc/main.htm> ;
    skos:definition
        "A model in which components react synchronously at logical instants."@en ,
        "Modelo no qual os componentes reagem sincronicamente em instantes lógicos."@pt-br .

:ContinuousTime rdf:type :ModelOfComputation ;
    dcterms:identifier "continuous_time" ;
    rdfs:label "Continuous Time"@en ,
        "Tempo contínuo"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/ptolemy/domains/continuous/doc/main.htm> ;
    skos:definition
        "A model in which continuous dynamics evolve over model time."@en ,
        "Modelo no qual dinâmicas contínuas evoluem ao longo do tempo do modelo."@pt-br .

:Rendezvous rdf:type :ModelOfComputation ;
    dcterms:identifier "rendezvous" ;
    rdfs:label "Rendezvous"@en ,
        "Rendezvous"@pt-br ;
    dcterms:source <https://ptolemy.berkeley.edu/ptolemyII/ptII11.0/ptII11.0.1/ptolemy/domains/rendezvous/doc/main.htm> ;
    skos:definition
        "A model of concurrent processes communicating by synchronized message transfers."@en ,
        "Modelo de processos concorrentes que se comunicam por transferências sincronizadas de mensagens."@pt-br .

#################################################################
# Object Properties
#################################################################

:hasPlan rdf:type owl:ObjectProperty ;
    rdfs:domain :Goal ;
    rdfs:range :Plan ;
    rdfs:label "Has plan"@en ,
        "Tem plano"@pt-br ;
    skos:definition
        "Links a goal to a plan intended to achieve it. Multiple plans can address the same goal."@en ,
        "Relaciona um objetivo a um plano destinado a alcançá-lo. Vários planos podem atender ao mesmo objetivo."@pt-br .

:hasStep rdf:type owl:ObjectProperty ;
    owl:inverseOf pplan:isStepOfPlan ;
    rdfs:domain :Plan ;
    rdfs:range :Step ;
    rdfs:label "Has step"@en ,
        "Tem etapa"@pt-br ,
        "Tiene etapa"@es ;
    skos:definition
        "Links a plan to a step belonging to it, as the inverse of pplan:isStepOfPlan."@en ,
        "Relaciona um plano a uma etapa que lhe pertence, como inversa de pplan:isStepOfPlan."@pt-br .

:canBeRealizedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Step ;
    rdfs:range [
        rdf:type owl:Class ;
        owl:unionOf (
            code:Capability
            obdc:Procedure
            sbpmnc:globalUserTask
            sbpmnc:globalManualTask
        )
    ] ;
    rdfs:label "Can be realized by"@en ,
        "Pode ser realizada por"@pt-br ;
    skos:definition
        "Links a step to an alternative means of realizing it. Each linked capability, procedure or reusable human task is a candidate for execution to produce the step's outputs."@en ,
        "Relaciona uma etapa a uma forma alternativa de realizá-la. Cada capacidade, procedimento ou tarefa humana reutilizável associada é uma opção de execução para produzir as saídas da etapa."@pt-br .

#################################################################
# Variables and requirements of procedure steps
#################################################################

:hasRequiredInputVar rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf pplan:hasInputVar ;
    rdfs:label "Has required input variable"@en ,
        "Tem variável de entrada obrigatória"@pt-br ;
    skos:definition
        "Links a step to a variable it reads and that must hold at least one value for the step to start."@en ,
        "Relaciona uma etapa a uma variável que ela lê e que precisa ter pelo menos um valor para a etapa começar."@pt-br .

:hasOptionalInputVar rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf pplan:hasInputVar ;
    rdfs:label "Has optional input variable"@en ,
        "Tem variável de entrada opcional"@pt-br ;
    skos:definition
        "Links a step to a variable it reads when the variable holds a value, and that may hold none."@en ,
        "Relaciona uma etapa a uma variável que ela lê quando a variável tem valor, e que pode não ter nenhum."@pt-br .

:hasRequiredOutputVar rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf pplan:hasOutputVar ;
    rdfs:label "Has required output variable"@en ,
        "Tem variável de saída obrigatória"@pt-br ;
    skos:definition
        "Links a step to a variable it produces and that must hold at least one value for the step to complete."@en ,
        "Relaciona uma etapa a uma variável que ela produz e que precisa ter pelo menos um valor para a etapa terminar."@pt-br .

:hasOptionalOutputVar rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf pplan:hasOutputVar ;
    rdfs:label "Has optional output variable"@en ,
        "Tem variável de saída opcional"@pt-br ;
    skos:definition
        "Links a step to a variable it produces and that may hold no value when the step completes. A requirement of a transition tells the outcomes apart."@en ,
        "Relaciona uma etapa a uma variável que ela produz e que pode ficar sem valor quando a etapa termina. Um requisito de uma transição distingue os resultados."@pt-br .

:valueType rdf:type owl:ObjectProperty ;
    rdfs:domain pplan:Variable ;
    rdfs:range rdfs:Class ;
    rdfs:label "Value type"@en ,
        "Tipo do valor"@pt-br ;
    skos:definition
        "The class or datatype of the values of a variable."@en ,
        "A classe ou o tipo de dado dos valores de uma variável."@pt-br .

:onVariable rdf:type owl:ObjectProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range pplan:Variable ;
    rdfs:label "On variable"@en ,
        "Sobre a variável"@pt-br ;
    skos:definition
        "The variable whose values a requirement evaluates."@en ,
        "A variável cujos valores um requisito avalia."@pt-br .

:minValues rdf:type owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Minimum number of values"@en ,
        "Número mínimo de valores"@pt-br ;
    skos:definition
        "A requirement holds only if its variable has at least this many values. It has the meaning of sh:minCount."@en ,
        "Um requisito só é satisfeito se sua variável tem pelo menos esta quantidade de valores. Tem o significado de sh:minCount."@pt-br .

:maxValues rdf:type owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Maximum number of values"@en ,
        "Número máximo de valores"@pt-br ;
    skos:definition
        "A requirement holds only if its variable has at most this many values. It has the meaning of sh:maxCount."@en ,
        "Um requisito só é satisfeito se sua variável tem no máximo esta quantidade de valores. Tem o significado de sh:maxCount."@pt-br .

:requiredValue rdf:type owl:DatatypeProperty ;
    rdfs:domain pko:Requirement ;
    rdfs:range rdfs:Literal ;
    rdfs:label "Required value"@en ,
        "Valor exigido"@pt-br ;
    skos:definition
        "A requirement holds only if its variable has this value among its values. It has the meaning of sh:hasValue. A requirement with more than one condition holds when all of them do."@en ,
        "Um requisito só é satisfeito se sua variável tem este valor entre seus valores. Tem o significado de sh:hasValue. Um requisito com mais de uma condição é satisfeito quando todas o são."@pt-br .

:dependsOn rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf ilap:hasConstraint ;
    rdfs:domain :Task ;
    rdfs:range :TaskConstraint ;
    rdfs:label "Depends on"@en ,
        "Depende de"@pt-br ;
    skos:definition
        "Links a dependent task to an activity constraint defining its dependency on another task."@en ,
        "Relaciona uma tarefa dependente a uma restrição de atividade que define sua dependência de outra tarefa."@pt-br .

:predecessorTask rdf:type owl:ObjectProperty ;
    rdfs:domain :TaskConstraint ;
    rdfs:range :Task ;
    rdfs:label "Predecessor task"@en ,
        "Tarefa predecessora"@pt-br ;
    skos:definition
        "Identifies the predecessor task referenced by a task dependency constraint."@en ,
        "Identifica a tarefa predecessora referenciada por uma restrição de dependência entre tarefas."@pt-br .

:dependsOnFinishToFinish rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:range :FinishToFinishTaskConstraint ;
    rdfs:comment "Based on RFC 9253, Section 4 (RELTYPE=FINISHTOFINISH): https://www.rfc-editor.org/rfc/rfc9253.html#section-4. Links the successor task to a FinishToFinishTaskConstraint instance; the constraint refers to its predecessor via predecessorTask."@en ,
        "Baseada na RFC 9253, seção 4 (RELTYPE=FINISHTOFINISH). Relaciona a tarefa sucessora a uma instância de FinishToFinishTaskConstraint; a restrição referencia a predecessora por predecessorTask."@pt-br ;
    rdfs:label "Depends on (finish-to-finish)"@en ,
        "Depende de (término-término)"@pt-br ;
    skos:definition
        "The dependent task cannot finish before the predecessor task finishes."@en ,
        "A tarefa dependente não pode terminar antes do término da tarefa predecessora."@pt-br .

:dependsOnFinishToStart rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:range :FinishToStartTaskConstraint ;
    rdfs:comment "Based on RFC 9253, Section 4 (RELTYPE=FINISHTOSTART): https://www.rfc-editor.org/rfc/rfc9253.html#section-4. Links the successor task to a FinishToStartTaskConstraint instance; the constraint refers to its predecessor via predecessorTask."@en ,
        "Baseada na RFC 9253, seção 4 (RELTYPE=FINISHTOSTART). Relaciona a tarefa sucessora a uma instância de FinishToStartTaskConstraint; a restrição referencia a predecessora por predecessorTask."@pt-br ;
    rdfs:label "Depends on (finish-to-start)"@en ,
        "Depende de (término-início)"@pt-br ;
    skos:definition
        "The dependent task cannot start before the predecessor task finishes."@en ,
        "A tarefa dependente não pode iniciar antes do término da tarefa predecessora."@pt-br .

:dependsOnStartToFinish rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:range :StartToFinishTaskConstraint ;
    rdfs:comment "Based on RFC 9253, Section 4 (RELTYPE=STARTTOFINISH): https://www.rfc-editor.org/rfc/rfc9253.html#section-4. Links the successor task to a StartToFinishTaskConstraint instance; the constraint refers to its predecessor via predecessorTask."@en ,
        "Baseada na RFC 9253, seção 4 (RELTYPE=STARTTOFINISH). Relaciona a tarefa sucessora a uma instância de StartToFinishTaskConstraint; a restrição referencia a predecessora por predecessorTask."@pt-br ;
    rdfs:label "Depends on (start-to-finish)"@en ,
        "Depende de (início-término)"@pt-br ;
    skos:definition
        "The dependent task cannot finish before the predecessor task starts."@en ,
        "A tarefa dependente não pode terminar antes do início da tarefa predecessora."@pt-br .

:dependsOnStartToStart rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:range :StartToStartTaskConstraint ;
    rdfs:comment "Based on RFC 9253, Section 4 (RELTYPE=STARTTOSTART): https://www.rfc-editor.org/rfc/rfc9253.html#section-4. Links the successor task to a StartToStartTaskConstraint instance; the constraint refers to its predecessor via predecessorTask."@en ,
        "Baseada na RFC 9253, seção 4 (RELTYPE=STARTTOSTART). Relaciona a tarefa sucessora a uma instância de StartToStartTaskConstraint; a restrição referencia a predecessora por predecessorTask."@pt-br ;
    rdfs:label "Depends on (start-to-start)"@en ,
        "Depende de (início-início)"@pt-br ;
    skos:definition
        "The dependent task cannot start before the predecessor task starts."@en ,
        "A tarefa dependente não pode iniciar antes do início da tarefa predecessora."@pt-br .

#################################################################
#    Classes
#################################################################

:WorkStream rdf:type owl:Class ,
        obdc:SurfaceableEntity ;
    rdfs:subClassOf obdc:DataEntity ;
    dcterms:identifier "work_stream" ;
    rdfs:label "Work Stream"@en ,
        "Frente de trabalho"@pt-BR ;
    rdfs:comment "Coherent scope of coordinated work within a project."@en ;
    schema:description "Project work scope that may be organized and managed through one or more project management frameworks. 5W2H is one supported framework."@en .

#################################################################
#    Object Properties
#################################################################

:what rdf:type owl:ObjectProperty ;
    rdfs:domain :FiveWTwoH ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "what"@en ,
        "o que"@pt-BR ;
    schema:description "Scope or work content associated with the 5W2H."@en .

:why rdf:type owl:ObjectProperty ;
    rdfs:domain :FiveWTwoH ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "why"@en ,
        "por que"@pt-BR ;
    schema:description "Purpose, need, or justification associated with the 5W2H."@en .

:who rdf:type owl:ObjectProperty ;
    rdfs:domain :FiveWTwoH ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "who"@en ,
        "quem"@pt-BR ;
    schema:description "Person, organization, team, role, or other data entity involved in the WorkStream."@en .

:where rdf:type owl:ObjectProperty ;
    rdfs:domain :FiveWTwoH ;
    rdfs:range obdc:DataEntity ;
    rdfs:label "where"@en ,
        "onde"@pt-BR ;
