@prefix representation: <http://datacenter.app.br/ontology/domain/aeco/kind_representation.ttl#> .
@prefix kind: <http://datacenter.app.br/ontology/domain/aeco/kind.ttl#> .
@prefix : <https://infobim.org/ontology/tool/entity/ifc_waste_terminal_type.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix ifc4owl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix omg: <https://w3id.org/omg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://infobim.org/ontology/tool/entity/ifc_waste_terminal_type.ttl>
    rdf:type owl:Ontology .


kind:RaloSeco rdfs:subClassOf
    [
        rdf:type owl:Restriction ;
        owl:onProperty crm:P138i_has_representation ;
        owl:someValuesFrom representation:FloorWasteRepresentation
    ] .

kind:RaloSifonado rdfs:subClassOf
    [
        rdf:type owl:Restriction ;
        owl:onProperty crm:P138i_has_representation ;
        owl:someValuesFrom representation:FloorTrapRepresentation
    ] .
