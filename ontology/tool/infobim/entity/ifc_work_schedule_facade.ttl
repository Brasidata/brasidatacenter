#################################################################

:ScopePlannedField rdf:type owl:NamedIndividual , facade:FacadeField ;
    schema:identifier "ScopePlanned" ; schema:name "Planned Scope"@en ;
    facade:fieldDatatype xsd:string ; facade:fieldOrder 140 ;
    facade:mapsToResource ibim:ScopePlanned ; :mapsToDimensionKind ibim:ScopePlanned ;
    facade:isRequired false ; facade:isMultivalued false .

:ScopeActualField rdf:type owl:NamedIndividual , facade:FacadeField ;
