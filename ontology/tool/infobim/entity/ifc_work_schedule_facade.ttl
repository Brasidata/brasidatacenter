:PredefinedTypeField rdf:type owl:NamedIndividual , facade:FacadeField ;
    schema:identifier "PredefinedType" ;
    schema:name "Predefined Type"@en ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 130 ;
    facade:mapsToResource ifcowl:predefinedType_IfcWorkSchedule ;
    facade:mapsToProperty ifcowl:predefinedType_IfcWorkSchedule ;
    :propertyOwnerClass ifcowl:IfcWorkSchedule ;
    :ifcAttributeName "PredefinedType" ;
    facade:isRequired false ;
    facade:isMultivalued false .

#################################################################
