    facade:mapsToResource ifcowl:startTime_IfcWorkControl ;
    facade:mapsToProperty ifcowl:startTime_IfcWorkControl ;
    :propertyOwnerClass ifcowl:IfcWorkControl ;
    :ifcAttributeName "StartTime" ;
    facade:isRequired false ;
    facade:isMultivalued false .

:FinishTimeField rdf:type owl:NamedIndividual , facade:FacadeField ;
    schema:identifier "FinishTime" ;
    schema:name "Finish Time"@en ;
    facade:fieldDatatype xsd:dateTime ;
    facade:fieldOrder 120 ;
    facade:mapsToResource ifcowl:finishTime_IfcWorkControl ;
    facade:mapsToProperty ifcowl:finishTime_IfcWorkControl ;
    :propertyOwnerClass ifcowl:IfcWorkControl ;
    :ifcAttributeName "FinishTime" ;
    facade:isRequired false ;
