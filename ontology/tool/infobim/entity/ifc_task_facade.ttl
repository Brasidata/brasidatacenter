:RemainingTimeField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "RemainingTime" ; schema:name "Remaining Time"@en ; facade:fieldDatatype xsd:duration ; facade:fieldOrder 300 ; facade:mapsToResource ifcowl:remainingTime_IfcTaskTime ; facade:mapsToProperty ifcowl:remainingTime_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "RemainingTime" ; facade:isRequired false ; facade:isMultivalued false .

:CompletionField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "Completion" ; schema:name "Completion"@en ; facade:fieldDatatype xsd:decimal ; facade:fieldOrder 310 ; facade:mapsToResource ifcowl:completion_IfcTaskTime ; facade:mapsToProperty ifcowl:completion_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "Completion" ; facade:isRequired false ; facade:isMultivalued false .

