:RelationNameField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "RelationName" ; schema:name "Relation Name"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 330 ; facade:mapsToResource ifcowl:name_IfcRoot ; facade:mapsToProperty ifcowl:name_IfcRoot ; :propertyOwnerClass ifcowl:IfcRelSequence ; :ifcAttributeName "Name" ; facade:isRequired false ; facade:isMultivalued true .

