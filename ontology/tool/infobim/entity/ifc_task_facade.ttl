:ActualStartField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "ActualStart" ; schema:name "Actual Start"@en ; facade:fieldDatatype xsd:dateTime ; facade:fieldOrder 280 ; facade:mapsToResource ifcowl:actualStart_IfcTaskTime ; facade:mapsToProperty ifcowl:actualStart_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "ActualStart" ; facade:isRequired false ; facade:isMultivalued false .

