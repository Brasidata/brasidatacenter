:LateFinishField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "LateFinish" ; schema:name "Late Finish"@en ; facade:fieldDatatype xsd:dateTime ; facade:fieldOrder 220 ; facade:mapsToResource ifcowl:lateFinish_IfcTaskTime ; facade:mapsToProperty ifcowl:lateFinish_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "LateFinish" ; facade:isRequired false ; facade:isMultivalued false .

:FreeFloatField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "FreeFloat" ; schema:name "Free Float"@en ; facade:fieldDatatype xsd:duration ; facade:fieldOrder 230 ; facade:mapsToResource ifcowl:freeFloat_IfcTaskTime ; facade:mapsToProperty ifcowl:freeFloat_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "FreeFloat" ; facade:isRequired false ; facade:isMultivalued false .

:TotalFloatField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "TotalFloat" ; schema:name "Total Float"@en ; facade:fieldDatatype xsd:duration ; facade:fieldOrder 240 ; facade:mapsToResource ifcowl:totalFloat_IfcTaskTime ; facade:mapsToProperty ifcowl:totalFloat_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "TotalFloat" ; facade:isRequired false ; facade:isMultivalued false .

:IsCriticalField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "IsCritical" ; schema:name "Is Critical"@en ; facade:fieldDatatype xsd:boolean ; facade:fieldOrder 250 ; facade:mapsToResource ifcowl:isCritical_IfcTaskTime ; facade:mapsToProperty ifcowl:isCritical_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "IsCritical" ; facade:isRequired false ; facade:isMultivalued false .

