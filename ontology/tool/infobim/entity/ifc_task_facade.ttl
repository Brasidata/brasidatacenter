@prefix : <https://infobim.org/ontology/entity/ifc_task/facade.ttl#> .
@prefix facade: <http://ontobdc.org/ontology/domain/facade.ttl#> .
@prefix ifcowl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <https://infobim.org/ontology/entity/ifc_task/facade.ttl#> .

<https://infobim.org/ontology/entity/ifc_task/facade.ttl>
    rdf:type owl:Ontology ;
    owl:imports <http://ontobdc.org/ontology/domain/facade.ttl> .

#################################################################
#    IFC source mapping
#################################################################

:propertyOwnerClass rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain facade:FacadeField ; rdfs:range owl:Class .

:ifcAttributeName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain facade:FacadeField ; rdfs:range xsd:string .

:IfcAttributeMappedFieldShape rdf:type sh:NodeShape ;
    sh:targetSubjectsOf :ifcAttributeName ;
    sh:property
        [ sh:path facade:mapsToProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:equals facade:mapsToResource ; sh:nodeKind sh:IRI ] ,
        [ sh:path :propertyOwnerClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ,
        [ sh:path :ifcAttributeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

#################################################################
#    Unified IFC Task facade
#################################################################

ifcowl:IfcTask facade:hasDataEntityFacade :IfcTaskFacade .

:IfcTaskFacade rdf:type owl:NamedIndividual , facade:DataEntityFacade ;
    schema:identifier "ifc_task_facade" ;
    schema:name "IFC Task Facade"@en ;
    schema:description "Unified facade exposing an IFC Task together with its task-time duration data and sequence relationships."@en ;
    facade:isFacadeOf ifcowl:IfcTask ;
    facade:hasFacadeField
        :GlobalIdField , :NameField , :DescriptionField , :ObjectTypeField ,
        :IdentificationField , :LongDescriptionField , :StatusField ,
        :WorkMethodField , :IsMilestoneField , :PriorityField ,
        :PredefinedTypeField , :TaskTimeNameField , :DataOriginField ,
        :UserDefinedDataOriginField , :DurationTypeField ,
        :ScheduleDurationField , :ScheduleStartField , :ScheduleFinishField ,
        :EarlyStartField , :EarlyFinishField , :LateStartField ,
        :LateFinishField , :FreeFloatField , :TotalFloatField ,
        :IsCriticalField , :StatusTimeField , :ActualDurationField ,
        :ActualStartField , :ActualFinishField , :RemainingTimeField ,
        :CompletionField , :RelationGlobalIdField , :RelationNameField ,
        :RelationDescriptionField , :RelatingProcessField ,
        :RelatedProcessField , :TimeLagField , :SequenceTypeField ,
        :UserDefinedSequenceTypeField .

#################################################################
#    IfcTask fields
#################################################################

:GlobalIdField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "GlobalId" ; schema:name "GlobalId"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 10 ; facade:mapsToResource ifcowl:globalId_IfcRoot ; facade:mapsToProperty ifcowl:globalId_IfcRoot ; :propertyOwnerClass ifcowl:IfcRoot ; :ifcAttributeName "GlobalId" ; facade:isRequired true ; facade:isMultivalued false .

:NameField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "Name" ; schema:name "Name"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 20 ; facade:mapsToResource ifcowl:name_IfcRoot ; facade:mapsToProperty ifcowl:name_IfcRoot ; :propertyOwnerClass ifcowl:IfcRoot ; :ifcAttributeName "Name" ; facade:isRequired false ; facade:isMultivalued false .

:DescriptionField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "Description" ; schema:name "Description"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 30 ; facade:mapsToResource ifcowl:description_IfcRoot ; facade:mapsToProperty ifcowl:description_IfcRoot ; :propertyOwnerClass ifcowl:IfcRoot ; :ifcAttributeName "Description" ; facade:isRequired false ; facade:isMultivalued false .

:ObjectTypeField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "ObjectType" ; schema:name "Object Type"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 40 ; facade:mapsToResource ifcowl:objectType_IfcObject ; facade:mapsToProperty ifcowl:objectType_IfcObject ; :propertyOwnerClass ifcowl:IfcObject ; :ifcAttributeName "ObjectType" ; facade:isRequired false ; facade:isMultivalued false .

:IdentificationField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "Identification" ; schema:name "Identification"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 50 ; facade:mapsToResource ifcowl:identification_IfcProcess ; facade:mapsToProperty ifcowl:identification_IfcProcess ; :propertyOwnerClass ifcowl:IfcProcess ; :ifcAttributeName "Identification" ; facade:isRequired false ; facade:isMultivalued false .

:LongDescriptionField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "LongDescription" ; schema:name "Long Description"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 60 ; facade:mapsToResource ifcowl:longDescription_IfcProcess ; facade:mapsToProperty ifcowl:longDescription_IfcProcess ; :propertyOwnerClass ifcowl:IfcProcess ; :ifcAttributeName "LongDescription" ; facade:isRequired false ; facade:isMultivalued false .

:StatusField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "Status" ; schema:name "Status"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 70 ; facade:mapsToResource ifcowl:status_IfcTask ; facade:mapsToProperty ifcowl:status_IfcTask ; :propertyOwnerClass ifcowl:IfcTask ; :ifcAttributeName "Status" ; facade:isRequired false ; facade:isMultivalued false .

:WorkMethodField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "WorkMethod" ; schema:name "Work Method"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 80 ; facade:mapsToResource ifcowl:workMethod_IfcTask ; facade:mapsToProperty ifcowl:workMethod_IfcTask ; :propertyOwnerClass ifcowl:IfcTask ; :ifcAttributeName "WorkMethod" ; facade:isRequired false ; facade:isMultivalued false .

:IsMilestoneField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "IsMilestone" ; schema:name "Is Milestone"@en ; facade:fieldDatatype xsd:boolean ; facade:fieldOrder 90 ; facade:mapsToResource ifcowl:isMilestone_IfcTask ; facade:mapsToProperty ifcowl:isMilestone_IfcTask ; :propertyOwnerClass ifcowl:IfcTask ; :ifcAttributeName "IsMilestone" ; facade:isRequired true ; facade:isMultivalued false .

:PriorityField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "Priority" ; schema:name "Priority"@en ; facade:fieldDatatype xsd:integer ; facade:fieldOrder 100 ; facade:mapsToResource ifcowl:priority_IfcTask ; facade:mapsToProperty ifcowl:priority_IfcTask ; :propertyOwnerClass ifcowl:IfcTask ; :ifcAttributeName "Priority" ; facade:isRequired false ; facade:isMultivalued false .

:PredefinedTypeField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "PredefinedType" ; schema:name "Predefined Type"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 110 ; facade:mapsToResource ifcowl:predefinedType_IfcTask ; facade:mapsToProperty ifcowl:predefinedType_IfcTask ; :propertyOwnerClass ifcowl:IfcTask ; :ifcAttributeName "PredefinedType" ; facade:isRequired false ; facade:isMultivalued false .

#################################################################
#    Flattened IfcTaskTime and IfcTaskDurationEnum fields
#################################################################

:TaskTimeNameField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "TaskTimeName" ; schema:name "Task Time Name"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 120 ; facade:mapsToResource ifcowl:name_IfcSchedulingTime ; facade:mapsToProperty ifcowl:name_IfcSchedulingTime ; :propertyOwnerClass ifcowl:IfcSchedulingTime ; :ifcAttributeName "Name" ; facade:isRequired false ; facade:isMultivalued false .

:DataOriginField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "DataOrigin" ; schema:name "Data Origin"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 130 ; facade:mapsToResource ifcowl:dataOrigin_IfcSchedulingTime ; facade:mapsToProperty ifcowl:dataOrigin_IfcSchedulingTime ; :propertyOwnerClass ifcowl:IfcSchedulingTime ; :ifcAttributeName "DataOrigin" ; facade:isRequired false ; facade:isMultivalued false .

:UserDefinedDataOriginField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "UserDefinedDataOrigin" ; schema:name "User-defined Data Origin"@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 140 ; facade:mapsToResource ifcowl:userDefinedDataOrigin_IfcSchedulingTime ; facade:mapsToProperty ifcowl:userDefinedDataOrigin_IfcSchedulingTime ; :propertyOwnerClass ifcowl:IfcSchedulingTime ; :ifcAttributeName "UserDefinedDataOrigin" ; facade:isRequired false ; facade:isMultivalued false .

:DurationTypeField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "DurationType" ; schema:name "Duration Type"@en ; schema:description "IfcTaskDurationEnum value: ELAPSEDTIME, WORKTIME, or NOTDEFINED."@en ; facade:fieldDatatype xsd:string ; facade:fieldOrder 150 ; facade:mapsToResource ifcowl:durationType_IfcTaskTime ; facade:mapsToProperty ifcowl:durationType_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "DurationType" ; facade:isRequired false ; facade:isMultivalued false .

:ScheduleDurationField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "ScheduleDuration" ; schema:name "Schedule Duration"@en ; facade:fieldDatatype xsd:duration ; facade:fieldOrder 160 ; facade:mapsToResource ifcowl:scheduleDuration_IfcTaskTime ; facade:mapsToProperty ifcowl:scheduleDuration_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "ScheduleDuration" ; facade:isRequired false ; facade:isMultivalued false .

:ScheduleStartField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "ScheduleStart" ; schema:name "Schedule Start"@en ; facade:fieldDatatype xsd:dateTime ; facade:fieldOrder 170 ; facade:mapsToResource ifcowl:scheduleStart_IfcTaskTime ; facade:mapsToProperty ifcowl:scheduleStart_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "ScheduleStart" ; facade:isRequired false ; facade:isMultivalued false .

