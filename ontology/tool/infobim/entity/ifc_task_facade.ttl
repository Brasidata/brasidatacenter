:EarlyFinishField rdf:type owl:NamedIndividual , facade:FacadeField ; schema:identifier "EarlyFinish" ; schema:name "Early Finish"@en ; facade:fieldDatatype xsd:dateTime ; facade:fieldOrder 200 ; facade:mapsToResource ifcowl:earlyFinish_IfcTaskTime ; facade:mapsToProperty ifcowl:earlyFinish_IfcTaskTime ; :propertyOwnerClass ifcowl:IfcTaskTime ; :ifcAttributeName "EarlyFinish" ; facade:isRequired false ; facade:isMultivalued false .

