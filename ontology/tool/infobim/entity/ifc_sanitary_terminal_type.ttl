@prefix : <https://infobim.org/ontology/tool/entity/ifc_sanitary_terminal_type.ttl#> .
@prefix aeco: <http://datacenter.app.br/ontology/domain/aeco/ns.ttl#> .
@prefix ifcowl: <https://standards.buildingsmart.org/IFC/DEV/IFC4/FINAL/OWL#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://infobim.org/ontology/tool/entity/ifc_sanitary_terminal_type.ttl#> .

<https://infobim.org/ontology/tool/entity/ifc_sanitary_terminal_type.ttl>
    rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

:ToiletPanRepresentation rdf:type owl:Class ;
    rdfs:subClassOf aeco:ToiletPan ,
        ifcowl:IfcSanitaryTerminal ,
        [
            rdf:type owl:Restriction ;
            owl:onProperty ifcowl:predefinedType_IfcSanitaryTerminal ;
            owl:hasValue ifcowl:TOILETPAN
        ] .
