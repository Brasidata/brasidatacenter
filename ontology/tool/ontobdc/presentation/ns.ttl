@prefix : <http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#> .
@prefix ewe: <http://gsi.upm.es/ontologies/ewe/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sem: <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@base <http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#> .

<http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl> rdf:type owl:Ontology ;
                                                                    owl:versionIRI <http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl/0.1.0> .

#################################################################
#    Classes
#################################################################

###  http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#DigitalAssistantPanel
:DigitalAssistantPanel rdf:type owl:Class ;
                       rdfs:subClassOf sioc:Container .


###  http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#DigitalDock
:DigitalDock rdf:type owl:Class ;
             rdfs:subClassOf ewe:Channel ,
                             sem:Actor .


###  http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#OntoAssistant
:OntoAssistant rdf:type owl:Class ;
               rdfs:subClassOf ewe:Channel ,
                               sioc:Item ,
                               sem:Actor, prov:SoftwareAgent .


###  http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#MessageParameter
:MessageParameter rdf:type owl:Class ;
                  rdfs:subClassOf dul:Parameter .


###  http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#PresentationEvent
:PresentationEvent rdf:type owl:Class ;
                   rdfs:subClassOf ewe:Event ,
                                   sem:Event .


#################################################################
#    Datatype Properties
#################################################################

###  http://datacenter.app.br/ontology/tool/ontobdc/presentation/ns.ttl#parameterName
:parameterName rdf:type owl:DatatypeProperty ;
               rdfs:domain :MessageParameter ;
               rdfs:range xsd:string .


###  http://gsi.upm.es/ontologies/ewe/ns#Channel
ewe:Channel rdf:type owl:Class .


###  http://gsi.upm.es/ontologies/ewe/ns#Event
ewe:Event rdf:type owl:Class .


###  http://rdfs.org/sioc/ns#Container
sioc:Container rdf:type owl:Class .


###  http://rdfs.org/sioc/ns#Item
sioc:Item rdf:type owl:Class .


###  http://semanticweb.cs.vu.nl/2009/11/sem/Actor
sem:Actor rdf:type owl:Class .


###  http://semanticweb.cs.vu.nl/2009/11/sem/Event
sem:Event rdf:type owl:Class .


