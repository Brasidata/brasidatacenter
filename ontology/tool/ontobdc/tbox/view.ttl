@prefix : <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix aria: <http://www.w3.org/WAI/ARIA/schemata/aria-1.rdf#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ontobdc/ns.ttl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@base <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#> .

<http://datacenter.app.br/ontology/ontobdc/domain/view.ttl> rdf:type owl:Ontology ;
                                                             rdfs:comment "Ontology for presentation layers, presentation surfaces, regions, tiles, declarative layout, support profiles, requests and runtime allocation."@en ;
                                                             rdfs:label "OntoBDC View Ontology"@en ;
                                                             rdfs:seeAlso <https://www.w3.org/TR/shacl12-ui/> ;
                                                             schema:description "Renderer-neutral semantic model for OntoBDC presentation composition. SHACL UI may be used inside semantic resource components, while this ontology governs surface composition."@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/ns/shacl#class
sh:class rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#datatype
sh:datatype rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#maxCount
sh:maxCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#minCount
sh:minCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#minInclusive
sh:minInclusive rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#path
sh:path rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#property
sh:property rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetClass
sh:targetClass rdf:type owl:AnnotationProperty .


###  https://schema.org/description
schema:description rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#allocatedBy
:allocatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Allocation ;
             rdfs:range :PresentationSurface ;
             rdfs:label "allocated by"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#allocationFor
:allocationFor rdf:type owl:ObjectProperty ;
               rdfs:domain :Allocation ;
               rdfs:range :Component ;
               rdfs:label "allocation for"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasAlignment
:hasAlignment rdf:type owl:ObjectProperty ;
              rdfs:domain :ComponentPlacement ;
              rdfs:range :PresentationAlignment ;
              rdfs:label "has alignment"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasAllocation
:hasAllocation rdf:type owl:ObjectProperty ;
               rdfs:domain :Component ;
               rdfs:range :Allocation ;
               rdfs:label "has allocation"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasComponentPlacement
:hasComponentPlacement rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf dul:hasPart ;
                       rdfs:domain :PresentationRegion ;
                       rdfs:range :ComponentPlacement ;
                       rdfs:label "has component placement"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasPresentationRole
:hasPresentationRole rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf dul:hasRole ;
                     rdfs:domain :Component ;
                     rdfs:range :PresentationRole ;
                     rdfs:label "has presentation role"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasRegion
:hasRegion rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf dul:hasPart ;
           rdfs:domain :PresentationSurface ;
           rdfs:range :PresentationRegion ;
           rdfs:label "has region"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasRequest
:hasRequest rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf dul:isDescribedBy ;
            rdfs:domain :Component ;
            rdfs:range :PresentationRequest ;
            rdfs:label "has request"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasSupportProfile
:hasSupportProfile rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf dul:isDescribedBy ;
                   rdfs:domain :Component ;
                   rdfs:range :PresentationSupportProfile ;
                   rdfs:label "has support profile"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#hasSurface
:hasSurface rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf dul:hasRegion ;
            rdfs:domain :PresentationLayer ;
            rdfs:range :PresentationSurface ;
            rdfs:label "has surface"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#placedInRegion
:placedInRegion rdf:type owl:ObjectProperty ;
                rdfs:domain :Component ;
                rdfs:range :PresentationRegion ;
                rdfs:comment "Runtime/materialized region relation; declarative composition should use ComponentPlacement."@en ;
                rdfs:label "placed in region"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#placesComponent
:placesComponent rdf:type owl:ObjectProperty ;
                 rdfs:domain :ComponentPlacement ;
                 rdfs:range :Component ;
                 rdfs:label "places component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#presentedIn
:presentedIn rdf:type owl:ObjectProperty ;
             rdfs:domain :Component ;
             rdfs:range :PresentationSurface ;
             rdfs:label "presented in"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#presentsEntity
:presentsEntity rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf schema:mainEntity ;
                rdfs:domain :EntityPage ;
                rdfs:range obdc:DataEntity ;
                rdfs:comment "Relates an Entity Page to the OntoBDC DataEntity presented as its principal entity."@en ;
                rdfs:label "presents entity"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#presentsEntityType
:presentsEntityType rdf:type owl:ObjectProperty ;
                    rdfs:domain :EntityPage ;
                    rdfs:range owl:Class ;
                    rdfs:comment "Relates a reusable Entity Page definition to the class of OntoBDC DataEntity instances it presents."@en ;
                    rdfs:label "presents entity type"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#promotesTo
:promotesTo rdf:type owl:ObjectProperty ;
            rdfs:domain :PresentationEvent ;
            rdfs:range :PresentationEvent ;
            rdfs:comment "Relates a presentation event definition to a presentation event definition it may be promoted to. A single source event may promote to more than one target event."@en ;
            rdfs:label "promotes to"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#usesTheme
:usesTheme rdf:type owl:ObjectProperty ;
           rdfs:range :Theme ;
           rdfs:label "uses theme"@en .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart
dul:hasPart rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRegion
dul:hasRegion rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasRole
dul:hasRole rdf:type owl:ObjectProperty .


###  http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isDescribedBy
dul:isDescribedBy rdf:type owl:ObjectProperty .


###  https://schema.org/mainEntity
schema:mainEntity rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#allocatedColumns
:allocatedColumns rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Allocation ;
                  rdfs:range xsd:integer ;
                  rdfs:label "allocated columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#allocatedMargin
:allocatedMargin rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Allocation ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "allocated margin"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#allocatedRows
:allocatedRows rdf:type owl:DatatypeProperty ;
               rdfs:domain :Allocation ;
               rdfs:range xsd:integer ;
               rdfs:label "allocated rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#borderRadius
:borderRadius rdf:type owl:DatatypeProperty ;
              rdfs:domain :PresentationRequest ;
              rdfs:range xsd:decimal ;
              rdfs:label "border radius"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#borderWidth
:borderWidth rdf:type owl:DatatypeProperty ;
             rdfs:domain :PresentationRequest ;
             rdfs:range xsd:decimal ;
             rdfs:label "border width"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#columnCount
:columnCount rdf:type owl:DatatypeProperty ;
             rdfs:domain :PresentationSurface ;
             rdfs:range xsd:integer ;
             rdfs:label "column count"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#columnSpan
:columnSpan rdf:type owl:DatatypeProperty ;
            rdfs:domain :PresentationRegion ;
            rdfs:range xsd:integer ;
            rdfs:label "column span"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#columnStart
:columnStart rdf:type owl:DatatypeProperty ;
             rdfs:domain :PresentationRegion ;
             rdfs:range xsd:integer ;
             rdfs:label "column start"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#gap
:gap rdf:type owl:DatatypeProperty ;
     rdfs:domain :PresentationSurface ;
     rdfs:range xsd:decimal ;
     rdfs:label "gap"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#language
:language rdf:type owl:DatatypeProperty ;
          rdfs:domain :PresentationRequest ;
          rdfs:range xsd:language ;
          rdfs:label "language"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#layoutPriority
:layoutPriority rdf:type owl:DatatypeProperty ;
                rdfs:domain :DefaultSurfaceLayout ;
                rdfs:range xsd:integer ;
                rdfs:comment "Selection priority among simultaneously eligible default layouts; higher values win. Not visual stacking or placement order."@en ;
                rdfs:label "layout priority"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#margin
:margin rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:decimal ;
        rdfs:label "margin"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#maxAvailableColumns
:maxAvailableColumns rdf:type owl:DatatypeProperty ;
                     rdfs:domain :DefaultSurfaceLayout ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Maximum measured logical column capacity for which this default layout is eligible."@en ;
                     rdfs:label "maximum available columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#maxAvailableRows
:maxAvailableRows rdf:type owl:DatatypeProperty ;
                  rdfs:domain :DefaultSurfaceLayout ;
                  rdfs:range xsd:integer ;
                  rdfs:label "maximum available rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#maxColumns
:maxColumns rdf:type owl:DatatypeProperty ;
            rdfs:domain :PresentationSupportProfile ;
            rdfs:range xsd:integer ;
            rdfs:label "maximum columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#maxRows
:maxRows rdf:type owl:DatatypeProperty ;
         rdfs:domain :PresentationSupportProfile ;
         rdfs:range xsd:integer ;
         rdfs:label "maximum rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#minAvailableColumns
:minAvailableColumns rdf:type owl:DatatypeProperty ;
                     rdfs:domain :DefaultSurfaceLayout ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Minimum measured logical column capacity for which this default layout is eligible."@en ;
                     rdfs:label "minimum available columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#minAvailableRows
:minAvailableRows rdf:type owl:DatatypeProperty ;
                  rdfs:domain :DefaultSurfaceLayout ;
                  rdfs:range xsd:integer ;
                  rdfs:label "minimum available rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#minColumns
:minColumns rdf:type owl:DatatypeProperty ;
            rdfs:domain :PresentationSupportProfile ;
            rdfs:range xsd:integer ;
            rdfs:label "minimum columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#minRows
:minRows rdf:type owl:DatatypeProperty ;
         rdfs:domain :PresentationSupportProfile ;
         rdfs:range xsd:integer ;
         rdfs:label "minimum rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#padding
:padding rdf:type owl:DatatypeProperty ;
         rdfs:domain :PresentationSurface ;
         rdfs:range xsd:decimal ;
         rdfs:label "padding"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#placementOrder
:placementOrder rdf:type owl:DatatypeProperty ;
                rdfs:domain :ComponentPlacement ;
                rdfs:range xsd:integer ;
                rdfs:label "placement order"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#preferredColumns
:preferredColumns rdf:type owl:DatatypeProperty ;
                  rdfs:domain :PresentationSupportProfile ;
                  rdfs:range xsd:integer ;
                  rdfs:label "preferred columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#preferredRows
:preferredRows rdf:type owl:DatatypeProperty ;
               rdfs:domain :PresentationSupportProfile ;
               rdfs:range xsd:integer ;
               rdfs:label "preferred rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#requestedColumns
:requestedColumns rdf:type owl:DatatypeProperty ;
                  rdfs:domain :PresentationRequest ;
                  rdfs:range xsd:integer ;
                  rdfs:label "requested columns"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#requestedRows
:requestedRows rdf:type owl:DatatypeProperty ;
               rdfs:domain :PresentationRequest ;
               rdfs:range xsd:integer ;
               rdfs:label "requested rows"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#rowCount
:rowCount rdf:type owl:DatatypeProperty ;
          rdfs:domain :PresentationSurface ;
          rdfs:range xsd:integer ;
          rdfs:label "row count"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#rowSpan
:rowSpan rdf:type owl:DatatypeProperty ;
         rdfs:domain :PresentationRegion ;
         rdfs:range xsd:integer ;
         rdfs:label "row span"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#rowStart
:rowStart rdf:type owl:DatatypeProperty ;
          rdfs:domain :PresentationRegion ;
          rdfs:range xsd:integer ;
          rdfs:label "row start"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#scrollable
:scrollable rdf:type owl:DatatypeProperty ;
            rdfs:domain :PresentationRegion ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Renderer-neutral indication that content exceeding the region extent may be navigated."@en ;
            rdfs:label "scrollable"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#slotSize
:slotSize rdf:type owl:DatatypeProperty ;
          rdfs:domain :PresentationSurface ;
          rdfs:range xsd:decimal ;
          rdfs:label "slot size"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#slotTarget
:slotTarget rdf:type owl:DatatypeProperty ;
            rdfs:domain :PresentationSurface ;
            rdfs:range xsd:decimal ;
            rdfs:label "slot target"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#supportsTheme
:supportsTheme rdf:type owl:DatatypeProperty ;
               rdfs:domain :PresentationSupportProfile ;
               rdfs:range xsd:boolean ;
               rdfs:label "supports theme"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#supportsTransparentBackground
:supportsTransparentBackground rdf:type owl:DatatypeProperty ;
                               rdfs:domain :PresentationSupportProfile ;
                               rdfs:range xsd:boolean ;
                               rdfs:label "supports transparent background"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#transparentBackground
:transparentBackground rdf:type owl:DatatypeProperty ;
                       rdfs:domain :PresentationRequest ;
                       rdfs:range xsd:boolean ;
                       rdfs:label "transparent background"@en .


#################################################################
#    Classes
#################################################################

###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#Allocation
:Allocation rdf:type owl:Class ;
            rdfs:subClassOf dul:Situation ;
            rdfs:comment "Runtime result of negotiation between a presentation surface and a component."@en ;
            rdfs:label "Allocation"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserButtonComponent
:BrowserButtonComponent rdf:type owl:Class ;
                        rdfs:subClassOf :BrowserWidgetComponent ,
                                        aria:button ;
                        rdfs:label "Browser Button Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserComponent
:BrowserComponent rdf:type owl:Class ;
                  rdfs:subClassOf :Component ;
                  rdfs:label "Browser Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserImageComponent
:BrowserImageComponent rdf:type owl:Class ;
                       rdfs:subClassOf :BrowserComponent ,
                                       aria:img ;
                       rdfs:label "Browser Image Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserLogComponent
:BrowserLogComponent rdf:type owl:Class ;
                     rdfs:subClassOf :BrowserComponent ,
                                     aria:log ;
                     rdfs:label "Browser Log Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserRegionComponent
:BrowserRegionComponent rdf:type owl:Class ;
                        rdfs:subClassOf :BrowserComponent ,
                                        aria:region ;
                        rdfs:label "Browser Region Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserStatusComponent
:BrowserStatusComponent rdf:type owl:Class ;
                        rdfs:subClassOf :BrowserComponent ,
                                        aria:status ;
                        rdfs:label "Browser Status Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserTimerComponent
:BrowserTimerComponent rdf:type owl:Class ;
                       rdfs:subClassOf :BrowserStatusComponent ,
                                       aria:timer ;
                       rdfs:label "Browser Timer Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserToolbarComponent
:BrowserToolbarComponent rdf:type owl:Class ;
                         rdfs:subClassOf :BrowserComponent ,
                                         aria:toolbar ;
                         rdfs:label "Browser Toolbar Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#BrowserWidgetComponent
:BrowserWidgetComponent rdf:type owl:Class ;
                        rdfs:subClassOf :BrowserComponent ,
                                        aria:widget ;
                        rdfs:label "Browser Widget Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#Component
:Component rdf:type owl:Class ;
           rdfs:subClassOf dul:InformationObject ;
           rdfs:label "Presentation Component"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#ComponentEvent
:ComponentEvent rdf:type owl:Class ;
                rdfs:subClassOf :PresentationEvent ;
                rdfs:label "Component Event"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#ComponentPlacement
:ComponentPlacement rdf:type owl:Class ;
                    rdfs:subClassOf dul:Description ;
                    rdfs:comment "Declarative placement of one component inside a region; distinct from runtime Allocation."@en ;
                    rdfs:label "Component Placement"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#ContentRegion
:ContentRegion rdf:type owl:Class ;
               rdfs:subClassOf :PresentationRegion ;
               rdfs:comment "Region containing contextual content whose ordering may change according to recency or another presentation policy."@en ;
               rdfs:label "Content Region"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#DefaultSurfaceLayout
:DefaultSurfaceLayout rdf:type owl:Class ;
                      rdfs:subClassOf :PresentationSurface ;
                      rdfs:comment "PresentationSurface eligible for automatic default selection when measured logical presentation capacity satisfies its applicability bounds. Selection is based on logical rows and columns, not device classes or CSS breakpoints."@en ;
                      rdfs:label "Default Surface Layout"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#EntityPage
:EntityPage rdf:type owl:Class ;
            rdfs:subClassOf schema:WebPage ;
            rdfs:comment "Web page whose principal subject is an OntoBDC DataEntity."@en ;
            rdfs:label "Entity Page"@en , "Página de Entidade"@pt-br.


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#FileSizeTile
:FileSizeTile rdf:type owl:Class ;
              rdfs:subClassOf :BrowserStatusComponent ,
                              :Tile ;
              rdfs:label "File Size Tile"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#GanttTile
:GanttTile rdf:type owl:Class ;
           rdfs:subClassOf :BrowserRegionComponent ,
                           :Tile ;
           rdfs:comment "Renders a schedule's tasks as a Gantt chart, one bar per task."@en ;
           rdfs:label "Gantt Tile"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#GlobalEvent
:GlobalEvent rdf:type owl:Class ;
             rdfs:subClassOf :PresentationEvent ;
             rdfs:label "Global Event"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#LanguageTile
:LanguageTile rdf:type owl:Class ;
              rdfs:subClassOf :BrowserButtonComponent ,
                              :Tile ;
              rdfs:label "Language Tile"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#LogoTile
:LogoTile rdf:type owl:Class ;
          rdfs:subClassOf :BrowserImageComponent ,
                          :Tile ;
          rdfs:label "Logo Tile"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#OperationRegion
:OperationRegion rdf:type owl:Class ;
                 rdfs:subClassOf :PresentationRegion ;
                 rdfs:label "Operation Region"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#PhotoTile
:PhotoTile rdf:type owl:Class ;
           rdfs:subClassOf :BrowserImageComponent ,
                           :Tile ;
           rdfs:label "Photo Tile"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#PinnedRegion
:PinnedRegion rdf:type owl:Class ;
              rdfs:subClassOf :PresentationRegion ;
              rdfs:comment "Region containing tiles explicitly pinned or selected for persistent presentation. Pinned does not imply renderer-specific fixed or sticky positioning."@en ;
              rdfs:label "Pinned Region"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#PresentationAlignment
:PresentationAlignment rdf:type owl:Class ;
                       rdfs:subClassOf dul:Description ;
                       rdfs:label "Presentation Alignment"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#PresentationEvent
:PresentationEvent rdf:type owl:Class ;
                   rdfs:subClassOf dul:Event ;
                   rdfs:label "Presentation Event"@en .


###  http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#PresentationLayer
:PresentationLayer rdf:type owl:Class ;
                   rdfs:subClassOf dul:Situation ;
                   rdfs:label "Presentation Layer"@en .


