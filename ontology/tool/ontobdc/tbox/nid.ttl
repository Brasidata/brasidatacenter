@prefix nid: <http://ontobdc.org/ontology/domain/ontobdc/nid.ttl#> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ontobdc/ns.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://ontobdc.org/ontology/domain/ontobdc/nid.ttl> rdf:type owl:Ontology .

nid:LanguageChanged
    rdf:type obdc:SharedEvent ;
    rdfs:label "Language changed"@en ;
    rdfs:comment "Semantic event individual indicating that the active presentation language has changed."@en .
