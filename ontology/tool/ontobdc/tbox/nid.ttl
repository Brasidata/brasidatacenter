@prefix nid: <http://ontobdc.org/ontology/domain/ontobdc/nid.ttl#> .
@prefix obdc: <http://ontobdc.org/ontology/domain/ontobdc/ns.ttl#> .
@prefix social: <http://datacenter.app.br/ontology/social/entity/ns.ttl#> .
@prefix view: <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://ontobdc.org/ontology/domain/ontobdc/nid.ttl> rdf:type owl:Ontology .

#################################################################
#    Language events
#################################################################

nid:LanguageSelectorTilePressed
    rdf:type obdc:ComponentEvent ;
    rdfs:label "Language selector tile pressed"@en ;
    rdfs:comment "Local component event indicating that the language selector Tile was pressed."@en ;
    prov:hadDerivation nid:LanguageChanged .

nid:LanguageChanged
    rdf:type obdc:SharedEvent ;
    rdfs:label "Language changed"@en ;
    rdfs:comment "Semantic shared event indicating that the active presentation language has changed within the current presentation/runtime context."@en ;
    prov:wasDerivedFrom nid:LanguageSelectorTilePressed ;
    prov:hadDerivation nid:LanguageSet .

nid:LanguageSet
    rdf:type obdc:GlobalEvent ;
    rdfs:label "Language set"@en ;
    rdfs:comment "Global event indicating that the selected language has been established for propagation to all relevant consumers beyond the local presentation context."@en ;
    prov:wasDerivedFrom nid:LanguageChanged .

nid:LanguageChangedShape
    rdf:type sh:NodeShape ;
    rdfs:comment "Reusable SHACL contract for LanguageChanged event payloads. The target must be a social Language DataEntity."@en ;
    sh:property [
        sh:path obdc:eventTarget ;
        sh:name "Selected language"@en ;
        sh:description "Language selected by the event. The target must be an instance of the canonical social Language class."@en ;
        sh:nodeKind sh:IRI ;
        sh:class social:Language ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

#################################################################
#    Color schemes
#################################################################

nid:DarkTheme
    rdf:type view:Theme ;
    rdfs:label "Dark theme"@en ,
               "Tema escuro"@pt-BR ;
    rdfs:comment "Presentation theme intended for dark color-scheme rendering."@en ,
                 "Tema de apresentação destinado à renderização em esquema de cores escuro."@pt-BR .

nid:LightTheme
    rdf:type view:Theme ;
    rdfs:label "Light theme"@en ,
               "Tema claro"@pt-BR ;
    rdfs:comment "Presentation theme intended for light color-scheme rendering."@en ,
                 "Tema de apresentação destinado à renderização em esquema de cores claro."@pt-BR .

#################################################################
#    Color schema events
#################################################################

nid:ColorSchemaSelectorTilePressed
    rdf:type obdc:ComponentEvent ;
    rdfs:label "Color schema selector tile pressed"@en ;
    rdfs:comment "Local component event indicating that the color-schema selector Tile was pressed."@en ;
    prov:hadDerivation nid:ColorSchemaChanged .

nid:ColorSchemaChanged
    rdf:type obdc:SharedEvent ;
    rdfs:label "Color schema changed"@en ;
    rdfs:comment "Semantic shared event indicating that the active presentation color schema has changed within the current presentation/runtime context."@en ;
    prov:wasDerivedFrom nid:ColorSchemaSelectorTilePressed .

nid:ColorSchemaChangedShape
    rdf:type sh:NodeShape ;
    rdfs:comment "Reusable SHACL contract for ColorSchemaChanged event payloads. The target must be one of the color schemes supported by OntoBDC."@en ;
    sh:property [
        sh:path obdc:eventTarget ;
        sh:name "Selected color schema"@en ;
        sh:description "Color schema selected by the event. The value must be one of the canonical OntoBDC theme individuals."@en ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( nid:DarkTheme nid:LightTheme )
    ] .
