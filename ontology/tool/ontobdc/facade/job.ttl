@prefix : <http://datacenter.app.br/ontology/tool/ontobdc/facade/job.ttl#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix facade: <http://datacenter.app.br/ontology/tool/ontobdc/facade/ns.ttl#> .
@prefix job: <http://datacenter.app.br/ontology/tool/ontobdc/core/job.ttl#> .
@prefix obdc: <http://datacenter.app.br/ontology/tool/ontobdc/core/ns.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix reference: <http://datacenter.app.br/ontology/tool/ontobdc/facade/reference.ttl#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://datacenter.app.br/ontology/tool/ontobdc/facade/job.ttl>
    rdf:type owl:Ontology ;
    schema:name "Job Facade"@en ,
        "Fachada de Job"@pt-br ,
        "Fachada de job"@es ;
    owl:imports
        <http://datacenter.app.br/ontology/tool/ontobdc/core/ns.ttl>,
        <http://datacenter.app.br/ontology/tool/ontobdc/core/job.ttl>,
        <http://datacenter.app.br/ontology/tool/ontobdc/facade/ns.ttl> .

#################################################################
# Facades
#################################################################

:JobFacade
    rdf:type facade:DataEntityFacade ;
    facade:isDeletable true ;
    facade:isCreatable true ;
    schema:identifier "job" ;
    schema:name "Job"@en ,
        "Job"@pt-br ,
        "Job"@es ;
    facade:isFacadeOf obdc:Job ;
    facade:hasFacadeField
        :GlobalIdField ,
        :TitleField ,
        :DescriptionField ,
        :CreatedAtField ,
        :ProcedureField .

#################################################################
# Fields
#################################################################

:GlobalIdField
    rdf:type facade:FacadeField ;
    schema:identifier "global_id" ;
    schema:name "Global ID"@en ,
        "Identificador global"@pt-br ,
        "Identificador global"@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 0 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:hasDefault facade:UuidGenerator ;
    facade:mapsToResource dcterms:identifier .

:TitleField
    rdf:type facade:FacadeField ;
    schema:identifier "title" ;
    schema:name "Title"@en ,
        "Título"@pt-br ,
        "Título"@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 1 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource dcterms:title .

:DescriptionField
    rdf:type facade:FacadeField ;
    schema:identifier "description" ;
    schema:name "Description"@en ,
        "Descrição"@pt-br ,
        "Descripción"@es ;
    facade:fieldDatatype xsd:string ;
    facade:fieldOrder 2 ;
    facade:isRequired false ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource dcterms:description .

:CreatedAtField
    rdf:type facade:FacadeField ;
    schema:identifier "created_at" ;
    schema:name "Created at"@en ,
        "Criada em"@pt-br ,
        "Creada el"@es ;
    facade:fieldDatatype xsd:dateTime ;
    csvw:format "M/d/yyyy h:mm a"@en ,
        "dd/MM/yyyy HH:mm"@pt-br ,
        "d/M/yyyy H:mm"@es ;
    facade:fieldOrder 3 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:hasDefault facade:CurrentDateTimeGenerator ;
    facade:mapsToResource dcterms:created .

:ProcedureField
    rdf:type facade:FacadeField ;
    schema:identifier "procedure" ;
    schema:name "Procedure"@en ,
        "Procedimento"@pt-br ,
        "Procedimiento"@es ;
    facade:fieldDatatype xsd:anyURI ;
    facade:fieldOrder 4 ;
    facade:isRequired true ;
    facade:isMultivalued false ;
    facade:isEditable true ;
    facade:mapsToResource job:executesProcedure ;
    facade:hasResourceFacade reference:EntityReferenceFacade .
