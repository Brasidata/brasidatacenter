@prefix : <http://datacenter.app.br/ontology/tool/ontobdc/abox/typification.ttl#> .
@prefix typ: <http://datacenter.app.br/ontology/tool/ontobdc/tbox/typification.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

<http://datacenter.app.br/ontology/tool/ontobdc/abox/typification.ttl>
    a owl:Ontology ;
    owl:imports <http://datacenter.app.br/ontology/tool/ontobdc/tbox/typification.ttl> ;
    rdfs:label "OntoBDC File Typification Vocabulary"@en .

:AutodeskAutoCADDWG
    a owl:NamedIndividual ;
    rdfs:label "Autodesk AutoCAD DWG"@en ;
    schema:identifier "dwg" ;
    typ:isTypeOf typ:EngineeringDrawing .

:AutodeskAutoCADDXF
    a owl:NamedIndividual ;
    rdfs:label "Autodesk AutoCAD DXF"@en ;
    schema:identifier "dxf" ;
    typ:isTypeOf typ:EngineeringDrawing .

:BuildingSMARTIFC
    a owl:NamedIndividual ;
    rdfs:label "buildingSMART IFC"@en ;
    schema:identifier "ifc" ;
    typ:isTypeOf typ:ConstructionModel .

:AutodeskRevitRVT
    a owl:NamedIndividual ;
    rdfs:label "Autodesk Revit RVT"@en ;
    schema:identifier "rvt" ;
    typ:isTypeOf typ:ConstructionModel .

:TrimbleSketchUpSKP
    a owl:NamedIndividual ;
    rdfs:label "Trimble SketchUp SKP"@en ;
    schema:identifier "skp" ;
    typ:isTypeOf typ:ConstructionModel .
