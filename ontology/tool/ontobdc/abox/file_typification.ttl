@prefix : <http://datacenter.app.br/ontology/tool/ontobdc/abox/file_typification.ttl#> .
@prefix typ: <http://datacenter.app.br/ontology/tool/ontobdc/tbox/typification.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

<http://datacenter.app.br/ontology/tool/ontobdc/abox/file_typification.ttl>
    a owl:Ontology ;
    owl:imports <http://datacenter.app.br/ontology/tool/ontobdc/tbox/typification.ttl> ;
    rdfs:label "OntoBDC File Typification Vocabulary"@en .

:EngineeringDrawing
    a typ:ArtifactType ;
    rdfs:label "Engineering drawing"@en , "Desenho de engenharia"@pt-BR ;
    schema:identifier "engineering-drawing" ;
    rdfs:comment "An information artifact whose primary semantic role is to communicate engineering information through a drawing, independently of whether it is stored as DWG, DXF, PDF, or another representation."@en .

:ConstructionModel
    a typ:ArtifactType ;
    rdfs:label "Construction model"@en , "Modelo de construção"@pt-BR ;
    schema:identifier "construction-model" ;
    rdfs:comment "An information artifact that represents a construction project, asset, facility, system, element, or assembly as a model, independently of its authoring software or exchange format."@en .

:Schedule
    a typ:ArtifactType ;
    rdfs:label "Schedule"@en , "Cronograma"@pt-BR ;
    schema:identifier "schedule" ;
    rdfs:comment "An information artifact describing planned, actual, or forecast activities and their temporal relationships."@en .

:Specification
    a typ:ArtifactType ;
    rdfs:label "Specification"@en , "Especificação"@pt-BR ;
    schema:identifier "specification" ;
    rdfs:comment "An information artifact defining technical requirements, criteria, materials, products, workmanship, or performance."@en .

:Report
    a typ:ArtifactType ;
    rdfs:label "Report"@en , "Relatório"@pt-BR ;
    schema:identifier "report" ;
    rdfs:comment "An information artifact presenting findings, status, analysis, observations, or recorded results."@en .

:Calculation
    a typ:ArtifactType ;
    rdfs:label "Calculation"@en , "Memória de cálculo"@pt-BR ;
    schema:identifier "calculation" ;
    rdfs:comment "An information artifact containing engineering, technical, commercial, or project calculations and their supporting assumptions."@en .

:Photograph
    a typ:ArtifactType ;
    rdfs:label "Photograph"@en , "Fotografia"@pt-BR ;
    schema:identifier "photograph" ;
    rdfs:comment "An information artifact whose primary role is to provide photographic evidence or visual documentation."@en .

:Correspondence
    a typ:ArtifactType ;
    rdfs:label "Correspondence"@en , "Correspondência"@pt-BR ;
    schema:identifier "correspondence" ;
    rdfs:comment "An information artifact whose primary role is formal or informal communication between project participants."@en .

:Dataset
    a typ:ArtifactType ;
    rdfs:label "Dataset"@en , "Conjunto de dados"@pt-BR ;
    schema:identifier "dataset" ;
    rdfs:comment "An information artifact primarily intended to provide structured or semi-structured data for processing, exchange, analysis, or reference."@en .
