@prefix : <http://datacenter.app.br/ontology/productivity/entity/work_stream/facade.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix type: <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://datacenter.app.br/ontology/productivity/entity/work_stream/facade.ttl#> .

<http://datacenter.app.br/ontology/productivity/entity/work_stream/facade.ttl>
    rdf:type owl:Ontology ;
    owl:imports <http://datacenter.app.br/ontology/productivity/entity/work_stream/type.ttl> .

#################################################################
#    Classes
#################################################################

:DataEntityFacade rdf:type owl:Class ;
    rdfs:label "Data Entity Facade"@en ;
    schema:description "Tabular projection of an entity class."@en .

:FacadeField rdf:type owl:Class ;
    rdfs:label "Facade Field"@en ;
    schema:description "A workbook field exposed by an entity facade."@en .

#################################################################
#    Object Properties
#################################################################

:hasDataEntityFacade rdf:type owl:ObjectProperty ;
    rdfs:domain owl:Class ;
    rdfs:range :DataEntityFacade .

:isFacadeOf rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasDataEntityFacade ;
    rdfs:domain :DataEntityFacade ;
    rdfs:range owl:Class .

:hasFacadeField rdf:type owl:ObjectProperty ;
    rdfs:domain :DataEntityFacade ;
    rdfs:range :FacadeField .

:fieldDatatype rdf:type owl:ObjectProperty ;
    rdfs:domain :FacadeField ;
    rdfs:range rdfs:Datatype .

:mapsToProperty rdf:type owl:ObjectProperty ;
    rdfs:domain :FacadeField ;
    rdfs:range rdf:Property .

:mapsToDimensionKind rdf:type owl:ObjectProperty ;
    rdfs:domain :FacadeField ;
    rdfs:range type:WorkStreamDimensionKind .

#################################################################
#    Data Properties
#################################################################

:isRequired rdf:type owl:DatatypeProperty ;
    rdfs:domain :FacadeField ;
    rdfs:range xsd:boolean .

:isMultivalued rdf:type owl:DatatypeProperty ;
    rdfs:domain :FacadeField ;
    rdfs:range xsd:boolean .

#################################################################
#    WorkStream Facade
#################################################################

type:WorkStream :hasDataEntityFacade :WorkStreamFacade .

:WorkStreamFacade rdf:type owl:NamedIndividual ,
        :DataEntityFacade ;
    schema:identifier "work_stream_facade" ;
    schema:name "WorkStream Facade"@en ;
    schema:description "Workbook facade for all WorkStream instances registered in an InfoBIM project."@en ;
    :isFacadeOf type:WorkStream ;
    :hasFacadeField :GlobalIdField ,
        :NameField ,
        :DescriptionField ,
        :WhatField ,
        :WhyField ,
        :WhoField ,
        :WhereField ,
        :WhenField ,
        :HowField ,
        :HowMuchField .

:GlobalIdField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "GlobalId" ;
    schema:name "GlobalId"@en ;
    :fieldDatatype xsd:string ;
    :mapsToProperty schema:identifier ;
    :isRequired true ;
    :isMultivalued false .

:NameField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "Name" ;
    schema:name "Name"@en ;
    schema:description "Human-readable WorkStream title stored in the workbook."@en ;
    :fieldDatatype xsd:string ;
    :mapsToProperty dcterms:title ;
    :isRequired true ;
    :isMultivalued false .

:DescriptionField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "Description" ;
    schema:name "Description"@en ;
    schema:description "Free-text description of the work to be performed in the WorkStream."@en ;
    :fieldDatatype xsd:string ;
    :mapsToProperty dcterms:description ;
    :isRequired false ;
    :isMultivalued false .

:WhatField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "What" ;
    schema:name "What"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:What ;
    :isRequired false ;
    :isMultivalued false .

:WhyField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "Why" ;
    schema:name "Why"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:Why ;
    :isRequired false ;
    :isMultivalued false .

:WhoField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "Who" ;
    schema:name "Who"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:Who ;
    :isRequired false ;
    :isMultivalued false .

:WhereField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "Where" ;
    schema:name "Where"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:Where ;
    :isRequired false ;
    :isMultivalued false .

:WhenField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "When" ;
    schema:name "When"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:When ;
    :isRequired false ;
    :isMultivalued false .

:HowField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "How" ;
    schema:name "How"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:How ;
    :isRequired false ;
    :isMultivalued false .

:HowMuchField rdf:type owl:NamedIndividual ,
        :FacadeField ;
    schema:identifier "HowMuch" ;
    schema:name "How Much"@en ;
    :fieldDatatype xsd:string ;
    :mapsToDimensionKind type:HowMuch ;
    :isRequired false ;
    :isMultivalued false .
