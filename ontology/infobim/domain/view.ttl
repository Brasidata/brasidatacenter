@prefix infobim: <https://infobim.org/ontology/ns#> .
@prefix view: <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .

<https://infobim.org/ontology/domain/view>
    a owl:Ontology ;
    rdfs:label "InfoBIM View Ontology"@en ;
    rdfs:comment "InfoBIM-specific semantic vocabulary for facade definitions and facade fields used to project engineering-domain resources into presentation components."@en ;
    schema:description "Defines reusable InfoBIM facade descriptions, the fields that compose them, and mappings from facade fields to default RDF properties. Surface composition remains owned by the OntoBDC View Ontology."@en ;
    owl:imports <http://datacenter.app.br/ontology/ontobdc/domain/view.ttl> .

#################################################################
# Core classes
#################################################################

infobim:Facade
    a owl:Class ;
    rdfs:subClassOf dul:Description ;
    rdfs:label "Facade"@en ;
    rdfs:comment "Reusable semantic projection describing which fields of a domain resource are exposed to a presentation or interaction layer."@en .

infobim:FacadeField
    a owl:Class ;
    rdfs:subClassOf dul:Description ;
    rdfs:label "Facade Field"@en ;
    rdfs:comment "One field participating in an InfoBIM Facade. The field may declare a default RDF property and presentation metadata without owning renderer behavior."@en .

infobim:IfcProjectFacade
    a owl:Class ;
    rdfs:subClassOf infobim:Facade ;
    rdfs:label "IFC Project Facade"@en ;
    rdfs:comment "Facade definition for exposing the default human-facing projection of an IFC project resource."@en .

#################################################################
# Object properties
#################################################################

infobim:hasFacadeField
    a owl:ObjectProperty ;
    rdfs:domain infobim:Facade ;
    rdfs:range infobim:FacadeField ;
    rdfs:label "has facade field"@en ;
    rdfs:comment "Associates a facade with one of the fields that compose its semantic projection."@en .

infobim:defaultProperty
    a owl:ObjectProperty ;
    rdfs:domain infobim:FacadeField ;
    rdfs:range rdf:Property ;
    rdfs:label "default property"@en ;
    rdfs:comment "Identifies the RDF property used by default to obtain the value represented by a facade field."@en .

infobim:targetsClass
    a owl:ObjectProperty ;
    rdfs:domain infobim:Facade ;
    rdfs:range rdfs:Class ;
    rdfs:label "targets class"@en ;
    rdfs:comment "Identifies the domain class for which a facade is intended."@en .

#################################################################
# Datatype properties
#################################################################

infobim:fieldOrder
    a owl:DatatypeProperty ;
    rdfs:domain infobim:FacadeField ;
    rdfs:range xsd:integer ;
    rdfs:label "field order"@en ;
    rdfs:comment "Default logical order of a facade field inside its facade. This is domain projection order, not screen-placement order."@en .

infobim:fieldLabel
    a owl:DatatypeProperty ;
    rdfs:domain infobim:FacadeField ;
    rdfs:range rdf:langString ;
    rdfs:label "field label"@en ;
    rdfs:comment "Optional human-readable label associated with a facade field."@en .

infobim:isIdentifierField
    a owl:DatatypeProperty ;
    rdfs:domain infobim:FacadeField ;
    rdfs:range xsd:boolean ;
    rdfs:label "is identifier field"@en ;
    rdfs:comment "Indicates whether the field is the preferred identifier exposed by the facade."@en .

#################################################################
# IFC Project facade field classes
#################################################################

infobim:IfcProjectGlobalIdField
    a owl:Class ;
    rdfs:subClassOf infobim:FacadeField ;
    rdfs:label "IFC Project GlobalId Field"@en .

infobim:IfcProjectNameField
    a owl:Class ;
    rdfs:subClassOf infobim:FacadeField ;
    rdfs:label "IFC Project Name Field"@en .

infobim:IfcProjectDescriptionField
    a owl:Class ;
    rdfs:subClassOf infobim:FacadeField ;
    rdfs:label "IFC Project Description Field"@en .

infobim:IfcProjectLongNameField
    a owl:Class ;
    rdfs:subClassOf infobim:FacadeField ;
    rdfs:label "IFC Project Long Name Field"@en .

infobim:IfcProjectPhaseField
    a owl:Class ;
    rdfs:subClassOf infobim:FacadeField ;
    rdfs:label "IFC Project Phase Field"@en .

#################################################################
# Canonical facade instance and field instances
#################################################################

infobim:DefaultIfcProjectFacade
    a infobim:IfcProjectFacade ;
    rdfs:label "Default IFC Project Facade"@en ;
    infobim:hasFacadeField
        infobim:IfcProjectGlobalIdFieldDefault ,
        infobim:IfcProjectNameFieldDefault ,
        infobim:IfcProjectDescriptionFieldDefault ,
        infobim:IfcProjectLongNameFieldDefault ,
        infobim:IfcProjectPhaseFieldDefault .

infobim:IfcProjectGlobalIdFieldDefault
    a infobim:IfcProjectGlobalIdField ;
    infobim:fieldOrder 10 ;
    infobim:fieldLabel "GlobalId"@en ;
    infobim:isIdentifierField true .

infobim:IfcProjectNameFieldDefault
    a infobim:IfcProjectNameField ;
    infobim:fieldOrder 20 ;
    infobim:fieldLabel "Name"@en .

infobim:IfcProjectDescriptionFieldDefault
    a infobim:IfcProjectDescriptionField ;
    infobim:fieldOrder 30 ;
    infobim:fieldLabel "Description"@en .

infobim:IfcProjectLongNameFieldDefault
    a infobim:IfcProjectLongNameField ;
    infobim:fieldOrder 40 ;
    infobim:fieldLabel "Long name"@en .

infobim:IfcProjectPhaseFieldDefault
    a infobim:IfcProjectPhaseField ;
    infobim:fieldOrder 50 ;
    infobim:fieldLabel "Phase"@en .

# The exact IFC ontology/property IRIs are intentionally not hardcoded here
# until the project selects the canonical IFC RDF vocabulary/version used by
# InfoBIM. Once selected, the five default field instances above receive
# infobim:defaultProperty triples and DefaultIfcProjectFacade receives an
# infobim:targetsClass triple. This avoids binding the ontology to an assumed
# IFCOWL namespace/version.

#################################################################
# SHACL baseline
#################################################################

infobim:FacadeShape
    a sh:NodeShape ;
    sh:targetClass infobim:Facade ;
    sh:property [
        sh:path infobim:hasFacadeField ;
        sh:class infobim:FacadeField ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path infobim:targetsClass ;
        sh:class rdfs:Class ;
        sh:maxCount 1
    ] .

infobim:FacadeFieldShape
    a sh:NodeShape ;
    sh:targetClass infobim:FacadeField ;
    sh:property [
        sh:path infobim:defaultProperty ;
        sh:class rdf:Property ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path infobim:fieldOrder ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path infobim:isIdentifierField ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .
