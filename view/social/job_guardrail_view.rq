PREFIX jobid:   <http://datacenter.app.br/nid/social/job.ttl#>
PREFIX view:    <http://datacenter.app.br/view/social/job.ttl#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX schema:  <http://schema.org/>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT ?propertyName ?propertyType ?semanticUri ?isRequired ?propertyDescription ?isMultiLanguage ?pattern ?enumClassUri (GROUP_CONCAT(?enumValue; separator=",") AS ?enumValues)
WHERE {
  view:JobGuardrailViewShape a sh:NodeShape ;
                             sh:property ?propertyNode .
  
  ?propertyNode sh:name ?propertyName ;
                sh:path ?semanticUri .
                
  OPTIONAL {
    ?propertyNode sh:description ?propertyDescription .
  }
  
  OPTIONAL {
    ?propertyNode sh:pattern ?pattern .
  }
                
  OPTIONAL {
    ?propertyNode sh:datatype ?datatypeUri .
    BIND(
      IF(?datatypeUri = rdf:langString, "string",
      IF(?datatypeUri = xsd:string, "string",
      IF(?datatypeUri = xsd:integer, "integer",
      IF(?datatypeUri = xsd:boolean, "boolean", "string"))))
      AS ?propertyType
    )
    BIND(
      IF(?datatypeUri = rdf:langString, "true"^^xsd:boolean, "false"^^xsd:boolean)
      AS ?isMultiLanguage
    )
  }
  
  OPTIONAL {
    ?propertyNode sh:minCount ?minCount .
    BIND(IF(?minCount >= 1, "true"^^xsd:boolean, "false"^^xsd:boolean) AS ?isRequired)
  }

  OPTIONAL {
    ?propertyNode sh:in ?inList .
    ?inList rdf:rest*/rdf:first ?enumValue .
    
    # Tentamos buscar o class/type do elemento que é listado no sh:in
    # Para saber a qual DefinedTermSet (ou class) este enum pertence
    OPTIONAL {
      ?enumValue schema:inDefinedTermSet ?enumClassUri .
    }
  }
}
GROUP BY ?propertyName ?propertyType ?semanticUri ?isRequired ?propertyDescription ?isMultiLanguage ?pattern ?enumClassUri