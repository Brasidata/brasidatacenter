###  http://datacenter.app.br/view/social/job.ttl#JobGuardrailViewQueryResource
:JobGuardrailViewQueryResource rdf:type owl:NamedIndividual ,
                                        prof:ResourceDescriptor ;
                               dcterms:format "application/sparql-query" ;
                               dcterms:title "Job guardrail view SPARQL query resource"@en ;
                               prof:hasArtifact <http://datacenter.app.br/view/social/job_guardrail_view.rq> .


###  http://datacenter.app.br/view/social/job.ttl#JobGuardrailViewShape
:JobGuardrailViewShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                       prof:hasResource :JobGuardrailViewQueryResource ;
                       sh:description "Projection of a job guardrail view shape"@en ;
                       sh:name "JobGuardrailViewShape"@en ;
                       sh:property [ sh:datatype xsd:string ;
                                     sh:description "A unique string that identifies the job offer."@en ;
                                     sh:name "identifier" ;
                                     sh:minCount 1 ;
                                     sh:path dcterms:identifier ;
                                     sh:pattern "^[A-Za-z][A-Za-z0-9_]{2,127}$"
                                   ] ,
                                   [ sh:datatype rdf:langString ;
                                     sh:description "Human-readable name of the job offer."@en ;
                                     sh:minCount 1 ;
                                     sh:name "name" ;
                                     sh:path schema:name
                                   ] ,
                                   [ sh:datatype xsd:string ;
                                     sh:description "The organization offering the job."@en ;
                                     sh:name "hiringOrganization" ;
                                     sh:minCount 1 ;
                                     sh:path schema:hiringOrganization
                                   ] ,
                                   [ sh:datatype xsd:string ;
                                     sh:description "The geographic location of the job."@en ;
                                     sh:name "location" ;
                                     sh:minCount 1 ;
                                     sh:path schema:jobLocation
                                   ] ,
                                   [ sh:datatype xsd:string ;
                                     sh:description "The language of the job offer."@en ;
                                     sh:name "inLanguage" ;
                                     sh:minCount 1 ;
                                     sh:path schema:inLanguage
                                   ] ,
                                   [ sh:datatype xsd:string ;
                                     sh:description "Type of employment."@en ;
                                     sh:name "employmentType" ;
                                     sh:minCount 1 ;
                                     sh:path schema:employmentType ;
                                     sh:in ( jobid:CONTRACT jobid:FULL_TIME jobid:INTERNSHIP jobid:PART_TIME jobid:SEASONAL jobid:TEMPORARY )
                                   ] ,
                                   [ sh:datatype xsd:string ;
                                     sh:description "The location type of the job (e.g., hybrid, remote, onsite)."@en ;
                                     sh:name "jobLocationType" ;
                                     sh:minCount 1 ;
                                     sh:path schema:jobLocationType ;
                                     sh:in ( jobid:ASYNCHRONOUS jobid:HYBRID jobid:ONSITE jobid:REMOTE jobid:SYNCHRONOUS jobid:UNKNOWN )
                                   ] ;
                       sh:targetClass schema:DefinedTermSet .


